<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:dcterms="http://purl.org/dc/terms/"
>
   <rdf:Description rdf:about="http://rdf-vocabulary.ddialliance.org/cv/KindOfData/1.0.0/">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
      <dcterms:isVersionOf rdf:resource="null/1.0.0/"/>
      <skos:notation xml:lang="en">KindOfData</skos:notation>
      <dcterms:title xml:lang="en">Kind of Data</dcterms:title>
      <dcterms:description xml:lang="en">This controlled list distinguishes among types of data used in quantitative, qualitative, and mixed-methods research. 
</dcterms:description>
      <skos:prefLabel xml:lang="en">Kind of Data</skos:prefLabel>
      <dcterms:title xml:lang="fr">Type de donn&#xe9;es</dcterms:title>
      <dcterms:description xml:lang="fr">Ce vocabulaire permet de diff&#xe9;rencier les donn&#xe9;es en fonction de l&apos;utilisation d&apos;une m&#xe9;thode de recherche qualitative, quantitative ou mixte.</dcterms:description>
      <skos:prefLabel xml:lang="fr">Type de donn&#xe9;es</skos:prefLabel>
      <dcterms:title xml:lang="it">Tipo di dati</dcterms:title>
      <dcterms:description xml:lang="it">Questo elenco controllato distingue tra i tipi di dati utilizzati nella ricerca quantitativa, qualitativa e con metodi misti.</dcterms:description>
      <skos:prefLabel xml:lang="it">Tipo di dati</skos:prefLabel>
      <dcterms:title xml:lang="lt">Duomen&#x173; r&#x16b;&#x161;is</dcterms:title>
      <dcterms:description xml:lang="lt">&#x160;is kontroliuojamas &#x17e;odynas skiria duomen&#x173; tipus, naudojamus kiekybiniuose, kokybiniuose ir mi&#x161;ri&#x173; metod&#x173; tyrimuose.</dcterms:description>
      <skos:prefLabel xml:lang="lt">Duomen&#x173; r&#x16b;&#x161;is</skos:prefLabel>
      <dcterms:title xml:lang="nl">Soorten data</dcterms:title>
      <dcterms:description xml:lang="nl">Deze gecontroleerde lijst bevat termen om de soorten gegevens te beschrijven die worden gebruikt in kwantitatief, kwalitatief en mixed-methods onderzoek.</dcterms:description>
      <skos:prefLabel xml:lang="nl">Soorten data</skos:prefLabel>
      <dcterms:title xml:lang="sl">Tip podatkov</dcterms:title>
      <dcterms:description xml:lang="sl">Seznam razlikuje med vrstami podatkov, ki se uporabljajo v kvantitativnih, kvalitativnih in me&#x161;anih raziskavah.</dcterms:description>
      <skos:prefLabel xml:lang="sl">Tip podatkov</skos:prefLabel>
      <owl:versionInfo>1.0.0</owl:versionInfo>
