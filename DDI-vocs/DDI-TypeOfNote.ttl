@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/0be8406> a skos:Concept ;
    skos:definition "A human-readable comment, typically of a more subjective nature than an addendum."@en,
        "Žmogui suprantamas komentaras, paprastai subjektyvesnio pobūdžio nei papildymas."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Comment"@en ;
    skos:prefLabel "Comment"@en,
        "Komentaras"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/6311ae1> a skos:Concept ;
    skos:definition "Use when the type of note is known, but not found in the list."@en,
        "Naudoti, kai pastabos tipas yra žinomas, bet sąraše jo nėra."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en,
        "Kita"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/643562a> a skos:Concept ;
    skos:definition "A note related to the processing of the data, or metadata, or both."@en,
        "Pastaba, susijusi su duomenų ir (arba) metaduomenų tvarkymu."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Processing"@en ;
    skos:prefLabel "Processing note"@en,
        "Apdorojimo pastaba"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/a45da96> a skos:Concept ;
    skos:definition "A note generated by the processing system used to produce the data, or metadata, or both."@en,
        "Sistemos, skirtos duomenų ir (arba) metaduomenų kūrimui, sukurta pastaba."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "System"@en ;
    skos:prefLabel "System note"@en,
        "Sistemos pastaba"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/c680d43> a skos:Concept ;
    skos:definition "A note providing information on an aspect relevant for data usage that is likely to remain permanent, or a temporary note providing information for further review and correction. May be an observation entered by a human user or a system-generated note on any inconsistencies or deviations."@en,
        "Pastaba, kurioje pateikiama informacija apie duomenų naudojimui svarbų aspektą, greičiausiai būsianti aktuali visada, arba laikina pastaba, kurioje pateikiama informacija yra aktuali tolesnei peržiūrai ir taisymui. Tai gali būti žmogaus įvestas pastebėjimas arba sistemos sukurtas pastebėjimas apie bet kokius neatitikimus ar nukrypimus."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Observation"@en ;
    skos:prefLabel "Observation"@en,
        "Pastebėjimas"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/efcfc2f> a skos:Concept ;
    skos:definition "Additional information, usually of a factual nature (as opposed to a comment), intended to clarify the content of a DDI section or module."@en,
        "Papildoma informacija, paprastai faktinio pobūdžio (priešingai nei komentaras), skirta paaiškinti DDI skyriaus ar modulio turinį."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Addendum"@en ;
    skos:prefLabel "Addendum"@en,
        "Papildymas"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> a skos:ConceptScheme ;
    dcterms:description "Includes a typology of notes."@en,
        "Apima pastabų tipologiją."@lt ;
    dcterms:isVersionOf <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright ©DDI Alliance 2025" ;
    dcterms:title "Type of Note"@en,
        "Pastabos tipas"@lt ;
    owl:versionInfo "1.1.1" ;
    skos:hasTopConcept <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/0be8406>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/6311ae1>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/643562a>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/a45da96>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/c680d43>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/efcfc2f> ;
    skos:notation "TypeOfNote"@en ;
    skos:prefLabel "Type of Note"@en,
        "Pastabos tipas"@lt .

