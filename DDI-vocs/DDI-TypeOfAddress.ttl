    dcterms:rights "Copyright ©DDI Alliance 2020" ;
    dcterms:title "Type of Address"@en ;
    owl:versionInfo "1.1.0" ;
    skos:hasTopConcept <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/6311ae1>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/a9a6096>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/c8896d7> ;
    skos:notation "TypeOfAddress"@en ;
    skos:prefLabel "Type of Address"@en .

