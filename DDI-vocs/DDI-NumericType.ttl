        <http://rdf-vocabulary.ddialliance.org/cv/NumericType/1.1.0/30bb747>,
        <http://rdf-vocabulary.ddialliance.org/cv/NumericType/1.1.0/482be0d>,
        <http://rdf-vocabulary.ddialliance.org/cv/NumericType/1.1.0/6311ae1>,
        <http://rdf-vocabulary.ddialliance.org/cv/NumericType/1.1.0/8394f03>,
