        <http://rdf-vocabulary.ddialliance.org/cv/NumericType/1.1.0/d909d38>,
        <http://rdf-vocabulary.ddialliance.org/cv/NumericType/1.1.0/e93f994> ;
    skos:notation "NumericType"@en ;
    skos:prefLabel "Numeric Type"@en .

