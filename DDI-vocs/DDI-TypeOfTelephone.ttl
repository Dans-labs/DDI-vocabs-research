    skos:hasTopConcept <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/4457d44>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/6311ae1>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/87d17f4>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/9810aa2> ;
    skos:notation "TypeOfTelephone"@en ;
    skos:prefLabel "Type of Telephone"@en .

