        "Instrumento tipas"@lt,
        "Type meetinstrument"@nl,
        "Type instrument"@no,
        "Tipo de instrumento de recolha de dados"@pt,
        "Vrste instrumentov"@sl,
        "Vrsta Instrumenta"@sr,
        "Typ av instrument"@sv ;
    owl:versionInfo "1.1.2" ;
    skos:hasTopConcept <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/0e33f36>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/179d692>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/2399f21>,
