        "Tipo di dati"@it,
        "Duomenų rūšis"@lt,
        "Soorten data"@nl,
        "Tip podatkov"@sl ;
    owl:versionInfo "1.0.0" ;
    skos:hasTopConcept <http://rdf-vocabulary.ddialliance.org/cv/KindOfData/1.0.0/24f5e13>,
        <http://rdf-vocabulary.ddialliance.org/cv/KindOfData/1.0.0/64f5c8c>,
        <http://rdf-vocabulary.ddialliance.org/cv/KindOfData/1.0.0/699b4f7> ;
    skos:notation "KindOfData"@en ;
    skos:prefLabel "Kind of Data"@en,
        "Type de données"@fr,
        "Tipo di dati"@it,
        "Duomenų rūšis"@lt,
        "Soorten data"@nl,
        "Tip podatkov"@sl .

