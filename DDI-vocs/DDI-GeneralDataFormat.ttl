@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/31a45a8> a skos:Concept ;
    skos:definition "Virtuelle dreidimensionale Darstellungen von Objekten, Architektur, Orten usw."@de,
        "Virtual three-dimensional representations of objects, architecture, places, etc."@en,
        "Objektien, esineiden, arkkitehtuurin, paikkojen ym. virtuaaliset, kolmiulotteiset esitykset."@fi,
        "Représentation virtuelle en trois dimensions d'objets, d'architectures, de lieux, etc."@fr,
        "Rappresentazioni virtuali tridimensionali di oggetti, architetture, luoghi, ecc."@it,
        ""@nl,
        "Virtuelle tredimensjonale representasjoner av objekter, arkitektur, steder osv."@no,
        "Representações tridimensionais virtuais de objetos, arquitetura, lugares, etc."@pt,
        "Virtualne tridimenzionalne predstavitve predmetov, arhitekture, krajev itd."@sl,
        "Virtuelne trodimenzionalne reprezentacije objekata, arhitekture, mesta, itd."@sr,
        "Virtuell, tredimensionell representation av föremål, arkitektur, platser, m.m."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "ThreeD"@en ;
    skos:prefLabel "Dreidimensional"@de,
        "3D"@en,
        "3D"@fi,
        "Représentation 3D"@fr,
        "3D"@it,
        "Driedimensionaal"@nl,
        "3D"@no,
        "3D"@pt,
        "3D"@sl,
        "Trodimenzionalan"@sr,
        "3D"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/34e2d19> a skos:Concept ;
    skos:definition "Bewegte Bilder. Das können Filme, Animationen, digitale Aufnahmen, visuelle Ausgabe von Simulationen, aufgezeichnete Fernsehprogramme, etc. sein. Sie können stumm sein oder synchroniserten Ton haben."@de,
        "Moving images. May include films, animation, digital recordings, visual output from simulations, recorded television programs, etc. May be mute or may include synchronized sound."@en,
        "Liikkuva kuva. Esimerkiksi elokuvat, animaatiot, digitaaliset tallenteet, visuaalisesti esitetyt simulaatioiden sisällöt, tallennetut televisio-ohjelmat. Voi olla äänetön tai sisältää ääntä."@fi,
        "Images en mouvement. Peut inclure des films, de l'animation, des enregistrements digitaux, des visualisations de simulations, des émissions de télévision enregistrées, etc. Peut être muet ou peut inclure du son synchronisé."@fr,
        "Immagini in movimento. Possono includere film, animazioni, registrazioni digitali, output visuali ottenuti da simulazioni, registrazioni di programmi televisivi, ecc. Possono essere muti (senza audio) oppure includere audio sincronizzato alle immagini."@it,
        ""@nl,
        "Bevegelige bilder. Kan inkludere filmer, animasjon, digitale innspillinger, visuelle data fra simuleringer, opptak av tv-programmer etc. Kan være lydløse eller med synkronisert lyd."@no,
        "Imagens em movimento. Pode incluir filmes, animações, gravações digitais, produções visuais de simulações, programas de televisão gravados, etc. Pode ser mudo, ou pode incluir som sincronizado."@pt,
        "Gibljive slike. Lahko vključuje filme, animacije, digitalne posnetke, prikaze rezultatov simulacij, posnetke televizijskih programov ipd. Lahko so neme ali pa vključujejo zvočno sinhronizacijo."@sl,
        "Pokretne slike. Može da uključuje filmove, animacije, digitalne snimke, vizuelni izlaz simulacija, snimljenih televizijskih programa, itd. Može biti nemi ili može uključivati sinhronizovani zvuk."@sr,
        "Rörliga bilder. Kan inkludera film, animation, digitala inspelningar, visuella utdata från simulationer, inspelade TV-program, m.m. Kan vara ljudlösa eller med synkroniserat ljud."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "Video"@en ;
    skos:prefLabel "Video"@de,
        "Video"@en,
        "Video"@fi,
        "Vidéo"@fr,
        "Video"@it,
        "Video"@nl,
        "Video"@no,
        "Vídeo"@pt,
        "Video"@sl,
        "Video"@sr,
        "Video"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/5311744> a skos:Concept ;
    skos:definition "Statische Bilder wie Graphen, Zeichnungen, Fotografien, diagnostische/medizinische Bilder wie Röntgenbilder usw."@de,
        "Static images, such as graphs, drawings, photographs, diagnostic/medical images like X-rays, etc."@en,
        "Esimerkiksi graafit, piirrokset, valokuvat ja lääketieteellisen kuvantamisen tuotteet (esim. röntgen- tai ultraäänikuvat). Liikkuvan kuvan kohdalla käytä termiä 'Video'."@fi,
        "Images statiques, telles que des graphiques, des dessins, des photographies, des images de diagnostique/médicales comme des radiographies, etc."@fr,
        "Immagini statiche, come grafici, disegni, fotografie, immagini diagnostiche come i raggi X, ecc."@it,
        ""@nl,
        "Statiske bilder som f.eks grafer, tegninger, fotografier, diagnostiske/medisinske bilder (røntgenbilder etc.)."@no,
        "Imagens estáticas, como gráficos, desenhos, fotografias, imagens de diagnóstico/médicas como raios-x, etc."@pt,
        "Statične slike, kot so grafi, risbe, fotografije, diagnostične/medicinske slike, kot na primer rentgenske slike itd."@sl,
        "Statične slike, poput grafikona, crteža, fotografija, dijagnostičkih / medicinskih slika, poput rendgenskih zraka, itd."@sr,
        "Statiska bilder som t.ex. diagram, ritningar, fotografier, diagnostiska/medicinska bilder (röntgenbilder m.m.)."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "StillImage"@en ;
    skos:prefLabel "Unbewegtes Bild"@de,
        "Still image"@en,
        "Kuva"@fi,
        "Image fixe"@fr,
        "Immagine"@it,
        "Beeld"@nl,
        "Stillbilde"@no,
        "Imagens"@pt,
        "Mirujoča slika"@sl,
        "Nepokretna slika"@sr,
        "Stillbild"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/6311ae1> a skos:Concept ;
    skos:definition "Verwenden Sie diese Kategorie, wenn die Art des Datenformats bekannt, aber nicht in der Liste vertreten ist."@de,
        "Use when the kind of data format is known, but not found in the list."@en,
        "Käytä mikäli aineiston formaatti on tiedossa, mutta ei sanastossa."@fi,
        "Utilisez quand le genre de format de données est connu, mais pas présent dans la liste."@fr,
        "Utilizzare quando il tipo di formato dei dati è conosciuto, ma non è presente nell'elenco."@it,
        ""@nl,
        "Brukes dersom typen dataformat er kjent, men ikke finnes i listen."@no,
        "Usar se o formato dos dados for conhecido, mas não se encontrar na lista."@pt,
        "Uporabite, ko je vrsta podatkov znana, vendar je ne najdete na seznamu."@sl,
        "Koristite kada je vrsta formata podataka poznata, ali nije na listi."@sr,
        "Använd om typ av dataformat är känt men saknas i listan."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Andere"@de,
        "Other"@en,
        "Muu aineistoformaatti"@fi,
        "Autre"@fr,
        "Altro"@it,
        "Anders"@nl,
        "Annet"@no,
        "Outro"@pt,
        "Drugo"@sl,
        "Ostalo"@sr,
        "Övrigt"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/719d067> a skos:Concept ;
    skos:definition "Computerprogramm(e) im Quellcode (menschenlesbar) oder in kompilierter Form."@de,
        "Computer program(s) in source code (human-readable) or compiled form."@en,
        "Tietokoneohjelma/ohjelmia konekielisenä tai lähdekoodina (ihmisen luettavissa)."@fi,
        "Programme(s) informatique(s) en code source (lisible par l'homme) ou en format compilé."@fr,
        "Programmi per computer in codice sorgente (leggibile da esseri umani) o in forma compilata."@it,
        ""@nl,
        "Dataprogram(-er) i kildekode (menneskelesbar) eller kompilert form."@no,
        "Programa(s) de computador em código-fonte (legível por humanos) ou em forma codificada."@pt,
        "Računalniški programi v izvorni kodi (človeško berljivi) ali v prevedeni obliki."@sl,
        "Računarski program(i) u izvornom kodu (koji može biti čitljiv ljudima) ili u mašinskom obliku."@sr,
        "Datorprogram som källkod (människoläslig) eller i kompilerad form."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "Software"@en ;
    skos:prefLabel "Software"@de,
        "Software"@en,
        "Ohjelmisto"@fi,
        "Logiciel"@fr,
        "Software"@it,
        "Software"@nl,
        "Programvare"@no,
        " Software"@pt,
        "Programska oprema"@sl,
        "Softver"@sr,
        "Programvara"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/8732239> a skos:Concept ;
    skos:definition "Daten, die weitestgehend aus Werten bestehen, die durchZiffern von 0 bis 9 ausgedrückt werden und gegebenenfalls Zeichen für negative Werte, Dezimalkommata oder Buchstaben, mit denen beabsichtigt wird, Zahlen zu repräsentieren (z. B. A-F oder a-f in Hexadezimal)."@de,
        "Data consisting largely of values expressed as digits from 0 to 9 and, optionally, signs for negative values, decimal points, or letters only when intended to represent numbers (for example, A-F or a-f in hexadecimal)."@en,
        "Data koostuu enimmäkseen numeroilla 0-9 ilmaistuista arvoista ja mahdollisesti myös negatiivisten arvojen merkeistä tai desimaalierottimista. Datassa voi myös olla kirjaimia silloin, kun kirjainmerkit edustavat numerointia (esim. A-F tai a-f heksadesimaalijärjestelmässä)."@fi,
        "Données constituées largement de valeurs exprimées sous forme de chiffres de 0 à 9 et, facultativement, de signes pour des valeurs négatives, de points décimaux, ou de lettres seulement lorsqu'elles représentent des nombres (par exemple, A-F ou a-f en hexadécimal)"@fr,
        "I dati sono in gran parte rappresentati da valori espressi come cifre comprese tra 0 a 9 e, eventualmente, da segni per i valori negativi, da punti per i valori decimali o da lettere solo se destinati a rappresentare numeri (ad esempio, A-F o a-f nel sistema esadecimale)."@it,
        ""@nl,
        "Data som hovedsakelig består av verdier uttrykt som siffer fra 0 til 9, og eventuelt tegn for negative verdier, desimaltegn, eller bokstaver når de representerer tall (for eksempel A-F eller a-f i heksadesimaler)."@no,
        "Dados que consistem, geralmente, em valores expressos em dígitos de 0 a 9 e, opcionalmente, sinais para valores negativos, pontos decimais ou letras, apenas quando destinados a representar números (por exemplo, A-F ou a-f em hexadecimal)."@pt,
        "Podatki, ki so večinoma sestavljeni iz vrednosti, izraženih kot števke od 0 in 9, lahko tudi kot znaki za negativne vrednosti, decimalna ločila ali črke, ki so namenjene predstavitvi števil (na primer A-F ali a-f v šestnajstiškem zapisu)."@sl,
        "Podaci koji se uglavnom sastoje od vrednosti izraženih kao cifre od 0 do 9 i opciono znakova za negativne vrednosti, decimalne tačke ili slova, samo kada su namenjeni predstavljanju brojeva (na primer, A-F ili a-f u heksadecimalnoj vrednosti)."@sr,
        "Data som främst består av värden som uttrycks med siffrorna 0 till 9 och eventuellt tecken för negativa värden, decimalkomman, och bokstäver endast då de är avsedda att representera siffror (t.ex. A-F eller a-f för hexadecimala tal)."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "Numeric"@en ;
    skos:prefLabel "Numerisch"@de,
        "Numeric"@en,
        "Numeerinen"@fi,
        "Nombre"@fr,
        "Numerico"@it,
        "Numeriek"@nl,
        "Numeriske"@no,
        "Numérico"@pt,
        "Številski"@sl,
        "Numerički"@sr,
        "Numeriska"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/9dffbf6> a skos:Concept ;
    skos:definition "Daten, die weitestgehend aus Text bestehen, einschließlich Buchstaben, Ziffern und Sonderzeichen oder Symbolen, die schriftlich für Interpunktion, Abkürzung usw. verwendet werden. Zum Beispiel Interviewtranskriptionen, Erzählungen oder Essays, die von Studienteilnehmern verfasst wurden, Zeitungsartikeln usw."@de,
        "Data consisting largely of text, including letters, numbers, and special characters or symbols used in writing for punctuation, abbreviation, etc. For example, interview transcriptions, narratives or essays written by study participants, newspaper articles, etc."@en,
        "Data koostuu enimmäkseen tekstistä, mukaan lukien kirjainmerkit, numerot sekä erityismerkit tai symbolit, joita käytetään kirjoitetun tekstin välimerkkeinä, lyhenteissä jne. Esimerkiksi sanomalehtiartikkelit, haastatteluliteraatiot, tutkittavien kirjoittamat kertomukset tai esseet jne."@fi,
        "Données constituées largement de texte, incluant des lettres, des nombres, et des caractères spéciaux ou des symboles utilisés dans l'écriture de ponctuation, d'abréviation, etc. Par exemple, des transcriptions d'entretien, des récits ou des essais écrits par des participants à l'étude, des articles de journal, etc."@fr,
        "I dati sono formati in gran parte da elementi testuali, compresi lettere, numeri, caratteri speciali o simboli utilizzati nella scrittura per la punteggiatura, abbreviazioni, ecc. Ad esempio, trascrizioni di interviste, racconti o saggi scritti dai partecipanti allo studio, articoli di giornale, ecc."@it,
        ""@nl,
        "Data som hovedsakelig består av tekst, inkludert bokstaver, tall, og spesielle tegn eller symboler som brukes i skrift for tegnsetting, forkortelser etc. For eksempel intervjutranskripsjoner, fortellinger eller essay skrevet av studiedeltakere, avisartikler etc."@no,
        "Dados que consistem basicamente em textos, incluindo letras, números e caracteres especiais ou símbolos usados na escrita para pontuação, abreviatura, etc. Por exemplo, transcrições de entrevistas, narrativas ou ensaios escritos por participantes do estudo, artigos de jornais, etc."@pt,
        "Podatki, ki so večinoma sestavljeni iz besedila, vključno s črkami, številkami in posebnimi znaki ali simboli, ki se uporabljajo v pisni obliki za ločila, kratice, itd. Npr. transkripti intervjujev, pričevanja ali eseji, ki so jih napisali udeleženci raziskave, časopisni članki itd."@sl,
        "Podaci koji se uglavnom sastoje od teksta, uključujući slova, brojeve i posebne znakove ili simbole koji se koriste u pisanju kao interpunkcijski znaci, skraćenice, itd. Na primer, transkripti intervjua, svedočenja ili eseji koje su napisali učesnici studije, članci u novinama, itd."@sr,
        "Data som främst består av text, inklusive bokstäver, siffror och specialtecken eller symboler som används i skrift för interpunktion, förkortningar m.m. Exempel: intervjutranskripter, berättelser eller uppsatser skrivna av studiedeltagarna, tidningsartiklar, m.m."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "Text"@en ;
    skos:prefLabel "Text"@de,
        "Text"@en,
        "Teksti"@fi,
        "Texte"@fr,
        "Testuale"@it,
        "Tekst"@nl,
        "Tekst"@no,
        "Texto"@pt,
        "Besedilni"@sl,
        "Tekstualni"@sr,
        "Text"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/b22f041> a skos:Concept ;
    skos:definition "Aufgezeichneter Ton, inkl. Stimme, Musik, etc."@de,
        "Recorded sound, including voice, music, etc."@en,
        "Taltioitu ääni. Esimerkiksi puhe tai musiikki."@fi,
        "Son enregistré, incluant voix, musique, etc."@fr,
        "Registrazioni sonore, incluso voce, musica, ecc."@it,
        ""@nl,
        "Opptak av lyd, inkludert tale, musikk osv."@no,
        "Som gravado, incluindo voz, música, etc."@pt,
        "Posnet zvok, vključno z glasom, glasbo itd."@sl,
        "Snimljeni zvuk, uključujući glas, muziku i sl."@sr,
        "Inspelat ljud, inklusive tal, musik, m.m."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/GeneralDataFormat/2.0.3/> ;
    skos:notation "Audio"@en ;
    skos:prefLabel "Audio"@de,
