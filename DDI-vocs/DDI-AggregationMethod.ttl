@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/4dfc4f5> a skos:Concept ;
    skos:definition "The total of a frequency and all frequencies below it in a frequency distribution; the \"running total\" of frequencies [the maximum value is 100%]."@en,
        "Summen av en frekvens og alle frekvenser under den i en frekvensfordeling; den \"løpende sum\" av frekvenser [den maksimale verdien er 100%]."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "CumulativePercent"@en ;
    skos:prefLabel "Cumulative percent"@en,
        "Kumulativ prosent"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/6311ae1> a skos:Concept ;
    skos:definition "Use when the aggregation method is known, but not found in the list."@en,
        "Bruk når aggregeringsmetoden er kjent, men ikke er på denne listen."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en,
        "Annet"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/650be61> a skos:Concept ;
    skos:definition "The value that appears most often in a set of values."@en,
        "Den verdien som forekommer mest i et sett av verdier."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Mode"@en ;
    skos:prefLabel "Mode"@en,
        "Modus"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/66851a3> a skos:Concept ;
    skos:definition "The middle value in a series of values arranged sequentially from smallest to largest."@en,
        "Midtverdien i en serie av verdier som er arrangert i rekkefølge fra minst til størst."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Median"@en ;
    skos:prefLabel "Median"@en,
        "Median"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/7975ed0> a skos:Concept ;
    skos:definition "Mathematical average of a set of values. The mean is calculated by adding up two or more values and dividing the total by their number. In social/political science, it is usually the sum of the measurements divided by the number of subjects, or cases."@en,
        "Det matematiske gjennomsnittet til et sett av verdier. Gjennomsnittet beregnes ved å addere to eller flere verdier og dele summen på antallet verdier. I samfunnsvitenskapen er det som regel summen av målingene delt på antall subjekter eller tilfeller."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "ArithmeticMean"@en ;
    skos:prefLabel "Arithmetic mean"@en,
        "Aritmetisk gjennomsnitt"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/8321e79> a skos:Concept ;
    skos:definition "The highest value attained or recorded."@en,
        "Den høyeste oppnådde eller registrerte verdi."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Maximum"@en ;
    skos:prefLabel "Maximum"@en,
        "Maksimum"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/a0ec870> a skos:Concept ;
    skos:definition "A value obtained as a result of adding two or more numbers (items/amounts)."@en,
        "En verdi som er resultatet av å legge til to eller flere tall (elementer/mengder)."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Sum"@en ;
    skos:prefLabel "Sum"@en,
        "Sum"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/a1d0ec6> a skos:Concept ;
    skos:definition "The lowest value attained or recorded."@en,
        "Den laveste oppnådde eller registrerte verdi."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Minimum"@en ;
    skos:prefLabel "Minimum"@en,
        "Minimum"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/adaaee4> a skos:Concept ;
    skos:definition "The number of parts out of 100. In mathematics, a percentage is a number of ratio expressed as a fraction of 100. Percentages are used to express how large one quantity is relative to another quantity."@en,
        "Antall deler av 100. I matematikk er en prosentdel et forholdstall som er uttrykket som en andel av 100. Prosentdel er brukt for å uttrykke hvor stor en mengde er i forhold til en annen mengde."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Percent"@en ;
    skos:prefLabel "Percent"@en,
        "Prosent"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/bdc1c84> a skos:Concept ;
    skos:definition "The percentile rank of a item is the percentage of items in its frequency distribution which are lower [cannot reach 100%]."@en,
        "Persentil til en enhet er den prosentdelen av enheter i frekvensfordelingen som er lavere [kan ikke nå 100%]."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "PercentileRank"@en ;
    skos:prefLabel "Percentile rank"@en,
        "Persentil"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/e93f994> a skos:Concept ;
    skos:definition "Total number of units in a group of items."@en,
        "Samlet antall enhenter i en gruppe av elementer"@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> ;
    skos:notation "Count"@en ;
    skos:prefLabel "Count"@en,
        "Antall"@no .

<http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/> a skos:ConceptScheme ;
    dcterms:description "Identifies the type of aggregation used to combine related categories, usually within a common branch of a hierarchy, to provide information at a broader level than the level at which detailed observations are taken. (From: The OECD Glossary of Statistical Terms)"@en,
        """Identifiserer den type aggregering som brukes for å kombinere relaterte kategorier, vanligvis innenfor en felles
gren av et hierarki, for å gi informasjon på et bredere nivå enn det detaljerte nivået hvor observasjonene er tatt
fra. (Fra: OECD-ordlisten med statistiske begreper)"""@no ;
    dcterms:isVersionOf <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright ©DDI Alliance 2019" ;
    dcterms:title "Aggregation Method"@en,
        "Aggregeringsmetode"@no ;
    owl:versionInfo "1.1.2" ;
    skos:hasTopConcept <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/4dfc4f5>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/6311ae1>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/650be61>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/66851a3>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/7975ed0>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/8321e79>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/a0ec870>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/a1d0ec6>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/adaaee4>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/bdc1c84>,
        <http://rdf-vocabulary.ddialliance.org/cv/AggregationMethod/1.1.2/e93f994> ;
    skos:notation "AggregationMethod"@en ;
    skos:prefLabel "Aggregation Method"@en,
        "Aggregeringsmetode"@no .

