<http://rdf-vocabulary.ddialliance.org/cv/CharacterSet/1.0.0/d2cd825> a skos:Concept ;
    skos:definition "The official name is US-ASCII but use the format: ASCII. The ISO code for ASCII is ISO 14962."@en ;
