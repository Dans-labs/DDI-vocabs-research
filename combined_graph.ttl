<http://rdf-vocabulary.ddialliance.org/cv/TimeZone/1.0.0/315d268> a skos:Concept ;
    skos:definition "Alaska Standard Time (AKST)"@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TimeZone/1.0.0/> ;
