<http://rdf-vocabulary.ddialliance.org/cv/CharacterSet/1.0.0/deafe22> a skos:Concept ;
    skos:definition "For ISO standards, use format: ISO-n-n in Caption and ISOnn in Code. ISO standards are also known as Latin, for example, ISO-8859-1 as Latin1."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/CharacterSet/1.0.0/> ;
