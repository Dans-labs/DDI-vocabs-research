        "Summa"@fi,
        "Somma"@it,
        "Som"@nl,
        "Sum"@no,
        "Soma"@pt,
        "Vsota"@sl,
        "Zbir"@sr,
        "Summa"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/a1d0ec6> a skos:Concept ;
    skos:definition "The lowest valid value in a variable."@en,
        "Alin validi muuttujan arvo."@fi,
        "Il valore valido più basso assunto da una variabile."@it,
        ""@nl,
        "Den laveste gyldige verdien i en variabel."@no,
        "O menor valor válido de uma variável."@pt,
        "Najnižja veljavna vrednost spremenljivke."@sl,
        "Najniža ispravna vrednost promenljive."@sr,
        "Det lägsta giltiga värdet i en variabel."@sv ;
