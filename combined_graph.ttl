<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/6311ae1> a skos:Concept ;
    skos:definition "Use if type of address is known, but not found in the list."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/8ef080c> a skos:Concept ;
    skos:definition "Address for directing physical/conventional mail to a person's residence, including institutional residence."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:notation "Mailing.Residential"@en ;
    skos:prefLabel "Mailing address: Residential"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/a9a6096> a skos:Concept ;
    skos:definition "Address used to identify a physical location (typically a building or a unit in a building) that may be accessed in person."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/af04d20>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/d7892ee> ;
    skos:notation "Visiting"@en ;
    skos:prefLabel "Visiting address"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/af04d20> a skos:Concept ;
    skos:definition "Visiting address for a business, organization, or other type of association."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:notation "Visiting.Nonresidential"@en ;
    skos:prefLabel "Visiting address: Nonresidential"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/c1ddd21> a skos:Concept ;
    skos:definition "Address for directing physical/conventional mail to a business, organization, or other type of association."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:notation "Mailing.Nonresidential"@en ;
    skos:prefLabel "Mailing address: Nonresidential"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/c8896d7> a skos:Concept ;
    skos:definition "Includes both \"street\", and P.O. Box addresses used for sending and receiving physical/conventional mail through the postal system."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/8ef080c>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/c1ddd21> ;
    skos:notation "Mailing"@en ;
    skos:prefLabel "Mailing address"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/d7892ee> a skos:Concept ;
    skos:definition "Visiting address for a person's residence, including institutional residence."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfAddress/1.1.0/> ;
    skos:notation "Visiting.Residential"@en ;
    skos:prefLabel "Visiting address: Residential"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfConceptGroup/1.0.2/39872cc> a skos:Concept ;
    skos:definition "A concept group created to bring together concepts reflecting the same general theme, or topic; for example, a group called \"Trust\" can include trust in institutions, trust in government, as well as interpersonal trust."@en,
        "En konseptgruppe som lages for å knytte sammen konsepter som gjenspeiler det samme generelle tema eller emne; for eksempel, en gruppe kalt \"Tillit\" kan inkludere tillit til institusjoner, tillit til styresmakter, så vel som mellommenneskelige tillit."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfConceptGroup/1.0.2/> ;
    skos:notation "Thematic"@en ;
    skos:prefLabel "Thematic"@en,
        "Tematisk"@no .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfConceptGroup/1.0.2/6311ae1> a skos:Concept ;
    skos:definition "Use when the type of concept group is known, but not found in the list."@en,
        "Bruk når typen konseptgruppe er kjent, men ikke finnes på listen."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfConceptGroup/1.0.2/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en,
        "Annen"@no .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfConceptGroup/1.0.2/9ef1541> a skos:Concept ;
    skos:definition "A concept group created for administrative purposes, for instance for subsetting or reorganizing data."@en,
        "En konseptgruppe som lages for administrative formål, for eksempel for å subsette eller reorganisere data."@no ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfConceptGroup/1.0.2/> ;
    skos:notation "Administrative"@en ;
    skos:prefLabel "Administrative"@en,
        "Administrativ"@no .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/002f39b> a skos:Concept ;
    skos:definition "Data are collected every twenty years. Maps to SDMX code \"A20\"."@en,
        "Duomenys renkami kas dvidešimt metų. Atitinka SDMX kodą „A20“."@lt,
        "Podatki se zbirajo vsakih dvajset let. Označuje se s kodo SDMX \"A20\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTwentyYears"@en ;
    skos:prefLabel "Every twenty years"@en,
        "Kas dvidešimt metų"@lt,
        "Vsakih dvajset let"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/0140e68> a skos:Concept ;
    skos:definition "Data are collected every three years. Maps to SDMX code \"A3\"."@en,
        "Duomenys renkami kas trejus metus. Atitinka SDMX kodą „A3“."@lt,
        "Podatki se zbirajo vsaka tri leta. Označuje se s kodo SDMX \"A3\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryThreeYears"@en ;
    skos:prefLabel "Every three years"@en,
        "Kas trejus metus"@lt,
        "Vsaka tri leta"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/11f3fba> a skos:Concept ;
    skos:definition "Data are collected every two hours. Maps to SDMX code \"H2\"."@en,
        "Duomenys renkami kas dvi valandas. Atitinka SDMX kodą „H2“."@lt,
        "Podatki se zbirajo vsaki dve uri. Označuje se s kodo SDMX \"H2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTwoHours"@en ;
    skos:prefLabel "Every two hours"@en,
        "Kas dvi valandas"@lt,
        "Vsako uro"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/130fbad> a skos:Concept ;
    skos:definition "Data are collected every ten days. No matching SDMX code."@en,
        "Duomenys renkami kas dešimt dienų. Nėra atitinkančio SDMX kodo."@lt,
        "Podatki se zbirajo vsakih deset dni. Ni ustrezne kode SDMX."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTenDays"@en ;
    skos:prefLabel "Every ten days"@en,
        "Kas dešimt dienų"@lt,
        "Vsakih deset dni"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/1f08d62> a skos:Concept ;
    skos:definition "Data are collected every day of the calendar week. Maps to SDMX code \"D\"."@en,
        "Duomenys renkami kiekvieną kalendorinės savaitės dieną. Atitinka SDMX kodą „D“."@lt,
        "Podatki se zbirajo dnevno. Označuje se s kodo SDMX \"D\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryDay"@en ;
    skos:prefLabel "Every day"@en,
        "Kasdien"@lt,
        "Dnevno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/26d7ba7> a skos:Concept ;
    skos:definition "Data are collected every month. Maps to SDMX code \"M\"."@en,
        "Duomenys renkami kas mėnesį. Atitinka SDMX kodą „M“."@lt,
        "Podatki se zbirajo vsak mesec. Označuje se s kodo SDMX \"M\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryMonth"@en ;
    skos:prefLabel "Every month"@en,
        "Kas mėnesį"@lt,
        "Mesečno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/2ea450f> a skos:Concept ;
    skos:definition "Data are collected every year. Maps to SDMX code \"A\"."@en,
        "Duomenys renkami kasmet. Atitinka SDMX kodą „A“."@lt,
        "Podatki se zbirajo letno. Označuje se s kodo SDMX \"A\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryYear"@en ;
    skos:prefLabel "Every year"@en,
        "Kasmet"@lt,
        "Letno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/33bdb59> a skos:Concept ;
    skos:definition "Data are collected every three hours. Maps to SDMX code \"H3\"."@en,
        "Duomenys renkami kas tris valandas. Atitinka SDMX kodą „H3“."@lt,
        "Podatki se zbirajo vsake tri ure. Označuje se s kodo SDMX \"H3\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryThreeHours"@en ;
    skos:prefLabel "Every three hours"@en,
        "Kas tris valandas"@lt,
        "Vsake tri ure"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/3e0f3c6> a skos:Concept ;
    skos:definition "Data are collected every two months. Maps to SDMX code \"M2\"."@en,
        "Duomenys renkami kas du mėnesius. Atitinka SDMX kodą „M2“."@lt,
        "Podatki se zbirajo vsaka dva meseca. Označimo s kodo SDMX \"M2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTwoMonths"@en ;
    skos:prefLabel "Every two months"@en,
        "Kas du mėnesius"@lt,
        "Vsaka dva meseca"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/41fe2eb> a skos:Concept ;
    skos:definition "Data are collected every three weeks. Maps to SDMX code \"W3\"."@en,
        "Duomenys renkami kas tris savaites. Atitinka SDMX kodą „W3“."@lt,
        "Podatki se zbirajo vsake tri tedne. Označuje se s kodo SDMX \"W3\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryThreeWeeks"@en ;
    skos:prefLabel "Every three weeks"@en,
        "Kas tris savaites"@lt,
        "Vsake tri tedne"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/4a6550a> a skos:Concept ;
    skos:definition "Data are collected every week. Maps to SDMX code \"W\"."@en,
        "Duomenys renkami kiekvieną savaitę. Atitinka SDMX kodą „W“."@lt,
        "Podatki se zbirajo tedensko. Označuje se s kodo SDMX \"W\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryWeek"@en ;
    skos:prefLabel "Every week"@en,
        "Kiekvieną savaitę"@lt,
        "Tedensko"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/4e70e38> a skos:Concept ;
    skos:definition "Data are collected every two weeks. Maps to SDMX code \"W2\"."@en,
        "Duomenys renkami kas dvi savaites. Atitinka SDMX kodą „W2“."@lt,
        "Podatki se zbirajo vsakih štirinajst dni. Označuje se s kodo SDMX \"W2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTwoWeeks"@en ;
    skos:prefLabel "Every two weeks"@en,
        "Kas dvi savaites"@lt,
        "Vsaka dva tedna"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/50c39ed> a skos:Concept ;
    skos:definition "Data are collected every two years. Maps to SDMX code \"A2\"."@en,
        "Duomenys renkami kas dvejus metus. Atitinka SDMX kodą „A2“."@lt,
        "Podatki se zbirajo vsaki dve leti. Označuje se s kodo SDMX \"A2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTwoYears"@en ;
    skos:prefLabel "Every two years"@en,
        "Kas dvejus metus"@lt,
        "Vsaki dve leti"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/535863a> a skos:Concept ;
    skos:definition "Data are collected continuously. No matching SDMX code."@en,
        "Duomenys renkami tolydžiai. Nėra atitinkančio SDMX kodo."@lt,
        "Podatki se zbirajo neprekinjeno. Ni ustrezne kode SDMX."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "Continuous"@en ;
    skos:prefLabel "Continuous"@en,
        "Tolydus"@lt,
        "Neprekinjeno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/62725ee> a skos:Concept ;
    skos:definition "Data are collected every business or trading day (e.g. from Monday to Friday). Maps to SDMX code \"B\"."@en,
        "Duomenys renkami kiekvieną darbo arba prekybos dieną (pvz., nuo pirmadienio iki penktadienio). Atitinka SDMX kodą „B“."@lt,
        "Podatki se zbirajo vsak delovni ali trgovalni dan (npr. od ponedeljka do petka). Označuje se s kodo SDMX \"B\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryBusinessDay"@en ;
    skos:prefLabel "Every business day"@en,
        "Kiekvieną darbo dieną"@lt,
        "Vsak delovni dan"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/6311ae1> a skos:Concept ;
    skos:definition "Data are collected multiple times with a frequency that is known but not included in the list. For instance, data collection takes place every 5 hours and 32 minutes. Maps to SDMX code \"_O\". In DDI-Lifecycle elements that support CVs are of CodeValueType. If the \"Other\" value is entered in the element, the more specific value not found in the CV may be entered in the @otherValue attribute."@en,
        "Duomenys renkami kelis kartus žinomu, tačiau į sąrašą neįtrauktu dažnumu. Pvz., duomenys renkami kas 5 valandas ir 32 minutes. Atitinka SDMX kodą „_O“. DDI-Lifecycle elementai, kurie palaiko kontroliuojamus žodynus (KŽ), yra CodeValueType tipo. Jei elemente įrašoma reikšmė „Kita“, konkretesnė reikšmė, kurios nėra KŽ, gali būti įrašoma į atributą @otherValue."@lt,
        "Podatki se zbirajo večkrat, vendar pogostost ni določena ali znana. Označuje se s kodo SDMX \"_U\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en,
        "Kita"@lt,
        "Drugo"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/6cb8be6> a skos:Concept ;
    skos:definition "Data are collected every four years. Maps to SDMX code \"A4\"."@en,
        "Duomenys renkami kas ketverius metus. Atitinka SDMX kodą „A4“."@lt,
        "Podatki se zbirajo vsaka štiri leta. Označuje se s kodo SDMX \"A4\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryFourYears"@en ;
    skos:prefLabel "Every four years"@en,
        "Kas ketverius metus"@lt,
        "Vsaka štiri leta"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/6fcdc09> a skos:Concept ;
    skos:definition "Data are collected multiple times but the frequency is not specified or known. Maps to SDMX code \"_U\"."@en,
        "Duomenys renkami kelis kartus, tačiau dažnumas nenurodytas arba nežinomas. Atitinka SDMX kodą „_U“."@lt,
        "Podatki se zbirajo večkrat, vendar pogostost ni določena ali znana. Označuje se s kodo SDMX \"_U\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "Unspecified"@en ;
    skos:prefLabel "Unspecified"@en,
        "Nepatikslinta"@lt,
        "Nedoločeno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/7599922> a skos:Concept ;
    skos:definition "There is only one data collection event, no multiple occurrences. In those cases, this term can be used if the frequency element is mandatory in the metadata model. Maps to SDMX code \"_Z\"."@en,
        "Yra tik vienas duomenų rinkimo įvykis, kuris nėra kartojamas. Tokiais atvejais šį terminą galima naudoti, jei metaduomenų modelyje privalomas dažnumo elementas. Atitinka SDMX kodą „_Z“."@lt,
        "Obstaja samo en dogodek zbiranja podatkov, ni večkratnega pojavljanja. V teh primerih se ta izraz lahko uporabi, če je element pogostost v metapodatkovnem modelu obvezen. Označuje se s kodo SDMX \"_Z\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "NotApplicable"@en ;
    skos:prefLabel "Not applicable"@en,
        "Netaikoma"@lt,
        "Se ne nanaša"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/78d0215> a skos:Concept ;
    skos:definition "Data are collected twice a month. Maps to SDMX code \"M_2\"."@en,
        "Duomenys renkami du kartus per mėnesį. Atitinka SDMX kodą „M_2“."@lt,
        "Podatki se zbirajo dvakrat na mesec. Označuje se s kodo SDMX \"M_2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "TwiceAMonth"@en ;
    skos:prefLabel "Twice a month"@en,
        "Du kartus per mėnesį"@lt,
        "Dvakrat mesečno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/99b46e0> a skos:Concept ;
    skos:definition "Data are collected twice a day. Maps to SDMX code \"D_2\"."@en,
        "Duomenys renkami du kartus per dieną. Atitinka SDMX kodą „D_2“."@lt,
        "Podatki se zbirajo dvakrat na dan. Označuje se s kodo SDMX \"D_2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "TwiceADay"@en ;
    skos:prefLabel "Twice a day"@en,
        "Du kartus per dieną"@lt,
        "Dvakrat dnevno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/a5724cc> a skos:Concept ;
    skos:definition "Data are collected weekly but there is a planned, or unplanned gap between data collection periods. For instance, time-use data that are collected weekly but only during certain periods of time. No matching SDMX code."@en,
        "Duomenys renkami kas savaitę, tačiau tarp duomenų rinkimo laikotarpių yra planuotas arba neplanuotas tarpas. Pvz., laiko biudžeto duomenys, kurie renkami kas savaitę, bet tik tam tikrais laikotarpiais. Nėra atitinkančio SDMX kodo."@lt,
        "Podatki se zbirajo tedensko, vendar je med obdobji zbiranja podatkov načrtovana ali nenačrtovana vrzel. Na primer podatki o časovni uporabi, ki se zbirajo tedensko, vendar le v določenih časovnih obdobjih. Ni ustrezne kode SDMX."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "OccasionalWeekly"@en ;
    skos:prefLabel "Occasional weekly"@en,
        "Tam tikrais laikotarpiais kas savaitę"@lt,
        "Tedensko - občasno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/a586be6> a skos:Concept ;
    skos:definition "Data are collected daily but there is a planned, or unplanned gap between data collection periods. For instance, weather statistics on the depth of snow collected daily but only during winter months. No matching SDMX code."@en,
        "Duomenys renkami kasdien, tačiau tarp duomenų rinkimo laikotarpių yra planuotas arba neplanuotas tarpas. Pvz., oro sąlygų statistiniai duomenys apie sniego dangos storį renkami kasdien, bet tik žiemos mėnesiais. Nėra atitinkančio SDMX kodo."@lt,
        "Podatki se zbirajo vsak dan, vendar je med obdobji zbiranja podatkov načrtovana ali nenačrtovana vrzel. Na primer vremenski statistični podatki o globini snega se zbirajo dnevno, vendar le v zimskih mesecih. Ni ustrezne kode SDMX."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "OccasionalDaily"@en ;
    skos:prefLabel "Occasional daily"@en,
        "Tam tikrais laikotarpiais kasdien"@lt,
        "Dnevno - občasno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/b5ce97c> a skos:Concept ;
    skos:definition "Data are collected three times a week. Maps to SDMX code \"W_3\"."@en,
        "Duomenys renkami tris kartus per savaitę. Atitinka SDMX kodą „W_3“."@lt,
        "Podatki se zbirajo trikrat na teden. Označuje se s kodo SDMX \"W_3\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "ThreeTimesAWeek"@en ;
    skos:prefLabel "Three times a week"@en,
        "Tris kartus per savaitę"@lt,
        "Trikrat tedensko"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/b6fe088> a skos:Concept ;
    skos:definition "Data are collected annually but there is a gap between data collection periods. For instance, an annual survey does not succeed in getting funding every year for data collection. Maps to SDMX code \"OA\"."@en,
        "Duomenys renkami kasmet, tačiau tarp duomenų rinkimo laikotarpių yra tarpas. Pvz., kasmetinės apklausos duomenų rinkimui nepavyksta kasmet gauti finansavimą. Atitinka SDMX kodą „OA“."@lt,
        "Podatki se zbirajo vsako leto, vendar je med obdobji zbiranja podatkov vrzel. Na primer, letni raziskavi ne uspe vsako leto pridobiti sredstev za zbiranje podatkov. Označuje se s kodo SDMX \"OA\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "OccasionalAnnual"@en ;
    skos:prefLabel "Occasional annual"@en,
        "Tam tikrais laikotarpiais kasmet"@lt,
        "Letno - občasno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/b8be24a> a skos:Concept ;
    skos:definition "Data are collected three times a month. Maps to SDMX code \"M_3\"."@en,
        "Duomenys renkami tris kartus per mėnesį. Atitinka SDMX kodą „M_3“."@lt,
        "Podatki se zbirajo trikrat na mesec. Označuje se s kodo SDMX \"M_3\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "ThreeTimesAMonth"@en ;
    skos:prefLabel "Three times a month"@en,
        "Tris kartus per mėnesį"@lt,
        "Trikrat na mesec"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/bda54f9> a skos:Concept ;
    skos:definition "Data are collected every five years. Maps to SDMX code \"A5\"."@en,
        "Duomenys renkami kas penkerius metus. Atitinka SDMX kodą „A5“."@lt,
        "Podatki se zbirajo vsakih pet let. Označuje se s kodo SDMX \"A5\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryFiveYears"@en ;
    skos:prefLabel "Every five years"@en,
        "Kas penkerius metus"@lt,
        "Vsakih pet let"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/c597fb4> a skos:Concept ;
    skos:definition "Data are collected twice a year. No matching SDMX code."@en,
        "Duomenys renkami du kartus per metus. Nėra atitinkančio SDMX kodo."@lt,
        "Podatki se zbirajo dvakrat letno. Ni ustrezne kode SDMX."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "TwiceAYear"@en ;
    skos:prefLabel "Twice a year"@en,
        "Du kartus per metus"@lt,
        "Dvakrat letno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/c6b4bec> a skos:Concept ;
    skos:definition "Data are collected at irregular points in time. For example, time series data that record every stock trade or random events. The interval between each collection event is unpredictable and can vary in length. Maps to SDMX code \"I\"."@en,
        "Duomenys renkami nereguliariai. Pvz., laiko eilučių duomenys, kuriuose fiksuojama kiekviena akcijų prekyba arba atsitiktiniai įvykiai. Intervalas tarp kiekvieno duomenų rinkimo įvykio nenuspėjamas ir gali būti skirtingo ilgio. Atitinka SDMX kodą „I“."@lt,
        "Podatki se zbirajo v neenakomernih časovnih obdobjih. Na primer, podatki časovnih vrst, ki beležijo vsako trgovanje z delnicami ali naključne dogodke. Interval med posameznimi dogodki zbiranja je nepredvidljiv in je lahko različno dolg. Označuje se s kodo SDMX \"I\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "Irregular"@en ;
    skos:prefLabel "Irregular"@en,
        "Nereguliariai"@lt,
        "Neenakomerno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/c8a6851> a skos:Concept ;
    skos:definition "Data are collected every ten years. Maps to SDMX code \"A10\"."@en,
        "Duomenys renkami kas dešimt metų. Atitinka SDMX kodą „A10“."@lt,
        "Podatki se zbirajo vsakih deset let. Označuje se s kodo SDMX \"A10\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryTenYears"@en ;
    skos:prefLabel "Every ten years"@en,
        "Kas dešimt metų"@lt,
        "Vsakih deset let"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/ca0a52e> a skos:Concept ;
    skos:definition "Data are collected twice a week. Maps to SDMX code \"W_2\"."@en,
        "Duomenys renkami du kartus per savaitę. Atitinka SDMX kodą „W_2“."@lt,
        "Podatki se zbirajo dvakrat tedensko. Označuje se s kodo SDMX \"W_2\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "TwiceAWeek"@en ;
    skos:prefLabel "Twice a week"@en,
        "Du kartus per savaitę"@lt,
        "Dvakrat tedensko"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/ce9e3c9> a skos:Concept ;
    skos:definition "Data are collected every four weeks. Maps to SDMX code \"W4\"."@en,
        "Duomenys renkami kas keturias savaites. Atitinka SDMX kodą „W4“."@lt,
        "Podatki se zbirajo vsake štiri tedne. Označuje se s kodo SDMX \"W4\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryFourWeeks"@en ;
    skos:prefLabel "Every four weeks"@en,
        "Kas keturias savaites"@lt,
        "Vsake štiri tedne"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/dd15c91> a skos:Concept ;
    skos:definition "Data are collected every three months, or quarterly. Maps to SDMX code \"Q\"."@en,
        "Duomenys renkami kas tris mėnesius arba kas ketvirtį. Atitinka SDMX kodą „Q“."@lt,
        "Podatki se zbirajo vsake tri mesece ali četrtletno. Označuje se s kodo SDMX \"Q\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryThreeMonths"@en ;
    skos:prefLabel "Every three months"@en,
        "Kas tris mėnesius"@lt,
        "Vsake tri mesece"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/e2a7553> a skos:Concept ;
    skos:definition "Data are collected three times a year. Maps to SDMX code \"A_3\"."@en,
        "Duomenys renkami tris kartus per metus. Atitinka SDMX kodą „A_3“."@lt,
        "Podatki se zbirajo trikrat letno. Označuje se s kodo SDMX \"A_3\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "ThreeTimesAYear"@en ;
    skos:prefLabel "Three times a year"@en,
        "Tris kartus per metus"@lt,
        "Trikrat letno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/e3c0d3a> a skos:Concept ;
    skos:definition "Data are collected every hour. Maps to SDMX code \"H\"."@en,
        "Duomenys renkami kas valandą. Atitinka SDMX kodą „H“."@lt,
        "Podatki se zbirajo vsako uro. Označuje se s kodo SDMX \"H\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryHour"@en ;
    skos:prefLabel "Every hour"@en,
        "Kas valandą"@lt,
        "Vsako uro"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/eb65657> a skos:Concept ;
    skos:definition "Data are collected every thirty years. Maps to SDMX code \"A30\"."@en,
        "Duomenys renkami kas trisdešimt metų. Atitinka SDMX kodą „A30“."@lt,
        "Podatki se zbirajo vsakih trideset let. Označuje se s kodo SDMX \"A30\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryThirtyYears"@en ;
    skos:prefLabel "Every thirty years"@en,
        "Kas trisdešimt metų"@lt,
        "Vsakih trideset let"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/f2de11b> a skos:Concept ;
    skos:definition "Data are collected monthly but there is a planned, or unplanned gap between data collection periods. Intervals may span from one to several months. For example, data are collected monthly but only in spring, summer and fall (not in winter). Maps to SDMX code \"OM\"."@en,
        "Duomenys renkami kas mėnesį, tačiau tarp duomenų rinkimo laikotarpių yra planuotas arba neplanuotas tarpas. Pertraukos gali būti nuo vieno iki kelių mėnesių. Pvz., duomenys renkami kas mėnesį, bet tik pavasarį, vasarą ir rudenį (ne žiemą). Atitinka SDMX kodą „OM“."@lt,
        "Podatki se zbirajo mesečno, vendar je med obdobji zbiranja podatkov načrtovana ali nenačrtovana vrzel. Intervali lahko trajajo od enega do več mesecev. Na primer, podatki se zbirajo mesečno, vendar le spomladi, poleti in jeseni (ne pozimi). Označuje se s kodo SDMX \"OM\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "OccasionalMonthly"@en ;
    skos:prefLabel "Occasional monthly"@en,
        "Tam tikrais laikotarpiais kas mėnesį"@lt,
        "Mesečno - občasno"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/fb2f2a4> a skos:Concept ;
    skos:definition "Data are collected every minute. May be used even if there are occasional gaps between collection events.  Maps to SDMX code \"N\"."@en,
        "Duomenys renkami kas minutę. Gali būti naudojamas, net jei tarp duomenų rinkimo įvykių kartais būna didesni tarpai. Atitinka SDMX kodą „N“."@lt,
        "Podatki se zbirajo vsako minuto. Uporablja se lahko, tudi če so med zbiranjem občasne vrzeli. Označuje se s kodo SDMX \"N\"."@sl ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfFrequency/1.0.2/> ;
    skos:notation "EveryMinute"@en ;
    skos:prefLabel "Every minute"@en,
        "Kas minutę"@lt,
        "Vsako minuto"@sl .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/0e33f36> a skos:Concept ;
    skos:definition "Instruments used to collect objective data like measurements, images, etc. For example, chronometers, scales, speedometers, blood pressure monitors, thermometers, x-ray machines, etc."@en,
        "Objektiivisten havaintojen keräämiseen käytetyt välineet. Esimerkiksi verenpainemittarit, röntgenkuvat, ajanmittaus, nopeus- ja lämpötilamittarit jne."@fi,
        "Instruments utilisé pour collecter des données objectives comme des mesures, des images, etc. Par exemple, chronomètres, balances, compteurs de vitesse, tensiomètres, thermomètres, appareils à rayons X, etc."@fr,
        "Strumenti utilizzati per raccogliere dati oggettivi come misurazioni, immagini, ecc. Ad esempio, cronometri, scale, tachimetri, misuratori della pressione sanguigna, termometri, macchine a raggi X, ecc."@it,
        "Instrumentai naudojami objektyviems duomenims (tokiems kaip išmatavimai, nuotraukos ir kt.) rinkti. Pavyzdžiui, chronometrai, svarstyklės, spidometrai, kraujospūdžio matuokliai, termometrai, rentgeno aparatai ir kt."@lt,
        ""@nl,
        "Instrumenter brukt for å samle inn objektive data, slik som mål, bilder, etc. For eksempel kronometre, vekter, speedometre, blodtrykksmonitorer, termometere, røntgenmaskiner, etc."@no,
        "Instrumentos usados para recolher dados objetivos, como medições, imagens, etc. Por exemplo, cronómetros, balanças, velocímetros, monitores de pressão arterial, termómetros, máquinas de raio-x, etc."@pt,
        "Pripomočki, ki se uporabljajo za zbiranje objektivnih podatkov, kot so meritve, slike itd. Na primer kronometri, lestvice, merilniki hitrosti, naprave za merjenje krvnega tlaka, termometri, rentgen itd."@sl,
        "Instrumenti koji se koriste za prikupljanje objektivnih podataka kao što su merenja, slike, itd. Na primer, hronometri, vage, brzinomeri, merači krvnog pritiska, termometri, rendgenski aparati, itd."@sr,
        "Instrument som används för att samla in objektiva data som mätningar, bilder osv. Till exempel kronometrar, vågar, hastighetsmätare, blodtrycksmätare, termometrar, röntgenapparater osv."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "TechnicalInstruments"@en ;
    skos:prefLabel "Technical instrument(s)"@en,
        "Tekniset keruuvälineet"@fi,
        "Instrument(s) technique(s)"@fr,
        "Strumenti tecnici"@it,
        "Techninis (-iai) instrumentas (-ai)"@lt,
        "Technische hulpmiddelen"@nl,
        "Tekniske instrument(er)"@no,
        "Instrumento(s) técnico(s)"@pt,
        "Tehnični inštrument(i)"@sl,
        "Tehnički instrument(i)"@sr,
        "Tekniskt/-a instrument"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/179d692> a skos:Concept ;
    skos:definition "Set of pre-determined questions presented to study participants."@en,
        "Kysely- tai ilmoituslomake. Kysymykset ovat ennalta määriteltyjä."@fi,
        "Ensemble de questions prédéterminées présentées aux participants de l'étude"@fr,
        "Insieme di domande pre-determinate presentate ai partecipanti allo studio."@it,
        "Iš anksto parengtų klausimų, pateikiamų tyrimo dalyviams, rinkinys."@lt,
        ""@nl,
        "Oppsett med forhåndsbestemte spørsmål som blir presentert for studiedeltakerne."@no,
        "Conjunto de questões pré-determinadas apresentadas aos participantes do estudo."@pt,
        "Nabor vnaprej določenih vprašanj, predstavljenih udeležencem raziskave."@sl,
        "Skup unapred utvrđenih pitanja koja su predstavljena učesnicima studije."@sr,
        "En uppsättning förutbestämda frågor som ställs till deltagare i studien."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/8acc4c6>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/aa1571e>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/db1f13d> ;
    skos:notation "Questionnaire"@en ;
    skos:prefLabel "Questionnaire"@en,
        "Lomake"@fi,
        "Questionnaire"@fr,
        "Questionario"@it,
        "Klausimynas"@lt,
        "Vragenlijst"@nl,
        "Spørreskjema"@no,
        "Questionário"@pt,
        "Vprašalnik"@sl,
        "Upitnik"@sr,
        "Frågeformulär"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/1c6dc57> a skos:Concept ;
    skos:definition "Guidelines for a group discussion. Depending on the study design, a discussion guide can be more or less structured, ranging from exactly formulated questions to general ideas on what to discuss. For example, a list of topics to be discussed in a focus group, or themes formulated by a researcher to direct a blog discussion, etc."@en,
        "Ryhmäkeskusteluun annetut ohjeet. Tutkimusasetelmasta riippuen saattavat olla enemmän tai vähemmän strukturoituja, vaihdellen väljästi muotoilluista keskusteluteemoista tarkasti muotoiltuihin kysymyksiin. Esimerkkejä: Lista keskustelun teemoista, tutkijan esille ottamat tarkat aiheet ja muu ohjaus blogikeskusteluun jne."@fi,
        "Consignes pour un groupe de discussion. En fonction de la conception de l'étude, un guide de discussion peut être plus ou moins structuré, allant de questions formulées précisément à des idées générales sur quoi discuter. Par exemple, une liste de sujets à discutés dans un focus group, ou des thèmes formulés par un chercheur pour diriger une discussion sur un blog, etc."@fr,
        "Linee guida per una discussione di gruppo. A seconda del progetto del disegno della ricerca, una guida alla discussione può essere più o meno strutturata, variando tra domande formulate con precisione a idee generali sui temi da sottoporre alla discussione. Ad esempio, un elenco di argomenti da discutere in un focus group o temi formulati da un ricercatore per indirizzare una discussione su un blog, ecc."@it,
        "Grupinės diskusijos gairės. Priklausomai nuo tyrimo plano, diskusijų vadovas gali būti daugiau ar mažiau struktūruotas (pateikti tiksliai suformuluotus klausimus ar tik bendras diskusijos idėjas). Pavyzdžiui, temų sąrašas tikslinei grupės diskusijai, arba tematikos, kurias tyrėjas suformuluoja norėdamas kryptingai valdyti diskusiją tinklaraštyje ir kt."@lt,
        ""@nl,
        "Retningslinjer for en gruppediskusjon. En diskusjonsguide kan være mer eller mindre strukturert avhengig av studiedesignet. Den kan variere mellom nøyaktig formulerte spørsmål og løst formulerte ideer om hva en ønsker å diskutere. For eksempel en liste med tema å diskutere i en fokusgruppe, eller tema formulert av forsker for å lede en bloggdiskusjon, etc."@no,
        "Orientações ou instruções para uma discussão de grupo. Dependendo da concepção do estudo, um guião de discussão pode ser mais ou menos estruturado, variando de questões especificamente formuladas a ideias gerais sobre o que discutir/debater. Por exemplo, uma lista de tópicos a serem discutidos num grupo de foco, ou temas formulados por um investigador para orientar uma discussão num blog, etc."@pt,
        "Smernice za skupinsko razpravo. Glede na načrt raziskave je lahko vodnik za razpravo bolj ali manj strukturiran, od natančno oblikovanih vprašanj do splošnih idej o predmetu razprave. Na primer, seznam tem, o katerih bo razpravljala fokusna skupina, ali teme, ki jih oblikuje raziskovalec za usmerjanje razprave na spletnem blogu, itd."@sl,
        "Smernice za grupnu diskusiju. Zavisno od dizajna studije, vodič za diskusiju može biti manje ili više strukturiran, u rasponu od tačno formulisanih pitanja do opštih ideja o tome o čemu treba razgovarati. Na primer, spisak tema o kojima će se razgovarati u fokus grupi ili teme koje je formulisao istraživač kako bi usmeravao raspravu na blogu, itd."@sr,
        "Guide för en gruppdiskussion. Beroende på studiedesign kan en diskussionsguide vara mer eller mindre strukturerad, allt från exakt formulerade frågor till allmänna idéer om vad man ska diskutera. Till exempel en lista över ämnen som ska diskuteras i en fokusgrupp eller teman formulerade av en forskare för att styra en bloggdiskussion osv."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "DataCollectionGuidelines.DiscussionGuide"@en ;
    skos:prefLabel "Data collection guidelines: Discussion guide"@en,
        "Aineistonkeruuohjeistus: keskusteluohje"@fi,
        "Consignes de collecte de données : guide de discussion"@fr,
        "Linee guida per la raccolta dei dati: traccia di discussione"@it,
        "Duomenų rinkimo gairės: diskusijų vadovas"@lt,
        "Richtlijnen voor gegevensverzameling: Discussie handleiding"@nl,
        "Retningslinjer for datainnsamling: Diskusjonsguide"@no,
        "Orientações para a recolha de dados: Guião de debate"@pt,
        "Smernice za zbiranje podatkov: vodnik za razpravo"@sl,
        "Smernice za prikupljanje podataka: Uputstvo za razgovor (diskusiju)"@sr,
        "Datainsamlingsguide: Diskussionsguide"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/2399f21> a skos:Concept ;
    skos:definition "Directions or instructions regarding the methods and procedures to be used for collecting the data. Use a more specific term if possible."@en,
        "Suunnitelma tai ohjeet, jotka määrittelevät aineistonkeruun menetelmät ja prosessit. Käytä tarkempaa termiä mikäli mahdollista."@fi,
        "Directions ou instructions concernant les méthodes et les procédures à utiliser pour collecter les données. Utilisez un terme plus précis si possible."@fr,
        "Indicazioni o istruzioni relative ai metodi e alle procedure da utilizzare per la raccolta dei dati. Utilizzare un termine più specifico, se possibile."@it,
        "Duomenų rinkimo metodų ir procedūrų taikymo nurodymai ar instrukcijos. Jei įmanoma, naudoti konkretesnį terminą."@lt,
        ""@nl,
        "Retningslinjer og framgangsmåter som skal brukes for å samle inn dataene. Bruk et smalere begrep om mulig."@no,
        "Orientações ou instruções sobre os métodos e procedimentos a utilizar para recolher os dados. Se possível, usar um termo mais específico."@pt,
        "Smernice in navodila, ki opredeljujejo vsebino zajema podatkov. Če je mogoče, uporabite ožji izraz."@sl,
        "Uputstva ili smernice u vezi sa metodama i postupcima koji će se koristiti za prikupljanje podataka. Koristite precizniji izraz ako je moguće."@sr,
        "Guide och anvisningar som definierar innehållet i datainsamlingen. Använd en smalare term om möjligt."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/1c6dc57>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/439cdd3>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/732a2a6>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/bf31e36> ;
    skos:notation "DataCollectionGuidelines"@en ;
    skos:prefLabel "Data collection guidelines"@en,
        "Aineistonkeruuohjeistus"@fi,
        "Consignes de collecte de données"@fr,
        "Linee guida per la raccolta dei dati"@it,
        "Duomenų rinkimo gairės"@lt,
        "Richtlijnen voor gegevensverzameling"@nl,
        "Retningslinjer for datainnsamling"@no,
        "Orientações para a recolha de dados"@pt,
        "Smernice za zbiranje podatkov"@sl,
        "Smernice za prikupljanje podataka"@sr,
        "Datainsamlingsguide"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/439cdd3> a skos:Concept ;
    skos:definition "Guidelines specifying what data are to be collected from previously existing sources originally created for other purposes. For example, directions on how to select and code data from qualitative sources to create a quantitative dataset."@en,
        "Keruuohje tai -suunnitelma siitä, miten tutkimusaineisto muodostetaan jo aiemmin olemassa olevasta, muuta tarkoitusta varten tehdystä lähdemateriaalista. Esimerkiksi ohje sanomalehtimateriaalin poimimiseksi tutkimukseen tai poiminta- ja käsittelyohjeet jos jostain kvalitatiivisesta lähdemateriaalista muodostetaan numeerinen aineisto."@fi,
        "Consignes spécifiant quelles données sont collectées à partir de sources existantes précédemment créées pour d'autres fins. Par exemple, des directives sur comment sélectionner et coder des données à partir de sources qualitatives pour créer un ensemble de données quantitatives."@fr,
        "Linee guida che specificano quali dati devono essere raccolti da fonti precedentemente esistenti ma create originariamente per altri scopi. Ad esempio, indicazioni su come selezionare e codificare i dati da fonti qualitative per creare un dataset quantitativo."@it,
        "Gairės nurodančios, kokie duomenys turi būti renkami iš egzistuojančių šaltinių, sukurtų kitiems tikslams. Pavyzdžiui, nurodymai, kaip atrinkti ir koduoti duomenis iš kokybinių šaltinių, norint sukurti kiekybinių duomenų rinkinį."@lt,
        ""@nl,
        "Retningslinjer som spesifiserer hvilke opplysninger som skal hentes fra eksisterende datakilder som opprinnelig ble samlet for andre formål. For eksempel retningslinjer for hvordan opplysninger fra kvalitative kilder skal velges og kodes for å utarbeide kvantitative datasett."@no,
        "Orientações ou instruções que especificam que dados devem ser recolhidos de fontes anteriormente existentes criadas originalmente para outros fins. Por exemplo, instruções sobre como selecionar e codificar dados de fontes qualitativas para criar um conjunto de dados quantitativos."@pt,
        "Smernice, ki določajo, katere podatke je potrebno zbrati iz že obstoječih virov, ki so bili prvotno ustvarjeni za druge namene. Na primer navodila za izbiranje in kodiranje podatkov iz kakovostnih virov z namenom oblikovanja kvantitativnega nabora podatkov."@sl,
        "Smernice koje određuju koji se podaci prikupljaju iz prethodno postojećih izvora prvobitno kreiranih u druge svrhe. Na primer, uputstva o tome kako da odaberete i kodirate podatke iz kvalitativnih izvora kako biste stvorili kvantitativni skup podataka."@sr,
        "Guide som anger vilka data som ska samlas in från befintliga källor som ursprungligen skapats för andra ändamål. Till exempel anvisningar om hur man väljer och kodar data från kvalitativa källor för att skapa ett kvantitativt dataset."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "DataCollectionGuidelines.SecondaryDataCollectionGuide"@en ;
    skos:prefLabel "Data collection guidelines: Secondary data collection guide"@en,
        "Aineistonkeruuohjeistus: poimintaohje tai -suunnitelma"@fi,
        "Consignes de collecte de données : Guide de collecte de données secondaires"@fr,
        "Linee guida per la raccolta dei dati: dati secondari"@it,
        "Duomenų rinkimo gairės: antrinių duomenų rinkimo vadovas"@lt,
        "Richtlijnen voor gegevensverzameling: Handleiding voor de verzameling van secundaire gegevens"@nl,
        "Retningslinjer for datainnsamling: Guide for andregangsinnsamling av data"@no,
        "Orientações para a recolha de dados: Guião para recolha de dados secundários"@pt,
        "Smernice za zbiranje podatkov: vodnik za zbiranje sekundarnih podatkov"@sl,
        "Smernice za prikupljanje podataka: Vodič za prikupljanje sekundarnih podataka"@sr,
        "Datainsamlingsguide: Guide för insamling av sekundärdata"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/473938a> a skos:Concept ;
    skos:definition "A description of tasks that participants are asked to carry out as a part of the data collection process. For example, marking places on a map, taking photographs, telling a fairy tale, etc."@en,
        "Osanottajille annettu tehtävänanto, joka on osa aineistonkeruuprosessia. Esimerkiksi: Lempipaikkojen merkitseminen virtuaalikarttaan, valokuvien ottaminen, vitsien tai satujen kertominen."@fi,
        "Une description de tâches que les participants sont invités à effectuer dans le cadre du processus de collecte des données. Par exemple, marquer des endroits sur une carte, prendre des photographies, raconter un conte de fées, etc."@fr,
        "Una descrizione delle attività che i partecipanti sono invitati a svolgere come parte del processo di raccolta dei dati. Ad esempio, segnare i luoghi su una mappa, scattare fotografie, raccontare una fiaba, ecc."@it,
        "Užduočių, kurias dalyvių prašoma atlikti renkant duomenis, aprašas. Pavyzdžiui, pažymėti vietas žemėlapyje, fotografuoti, pasekti pasaką ir kt."@lt,
        ""@nl,
        "En beskrivelse av oppgavene deltakere blir bedt om å utføre som del av datainnsamlingsprosessen. For eksempel markere steder på et kart, ta bilder, fortelle et eventyr, etc."@no,
        "Descrição das tarefas que os participantes são convidados a realizar como parte do processo de recolha de dados. Por exemplo, marcar lugares num mapa, tirar fotografias, contar uma história infantil, etc."@pt,
        "Opis nalog, ki jih morajo udeleženci opraviti kot del postopka zbiranja podatkov. Na primer, označevanje mest na zemljevidu, fotografiranje, pripovedovanje pravljice itd."@sl,
        "Opis zadataka koji se od učesnika traže da izvrše kao deo procesa prikupljanja podataka. Na primer, obeležavanje mesta na mapi, fotografisanje, pričanje bajke itd."@sr,
        "En beskrivning av uppgifter som deltagare ombeds att utföra som en del av datainsamlingsprocessen. Till exempel att markera platser på en karta, fotografera, berätta en saga osv."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "ParticipantTasks"@en ;
    skos:prefLabel "Participant tasks"@en,
        "Osallistujatehtävä"@fi,
        "Tâches des participants"@fr,
        "Compiti del partecipante"@it,
        "Užduotys dalyviams"@lt,
        "Taken voor de deelnemers"@nl,
        "Deltakeroppgaver"@no,
        "Tarefas para os participantes"@pt,
        "Naloge udeležencev"@sl,
        "Zadaci učesnika"@sr,
        "Uppgifter för deltagarna"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/6311ae1> a skos:Concept ;
    skos:definition "Use when the type of instrument is known, but not found in the list."@en,
        "Käytetään jos keruuväline on tiedossa mutta ei listassa."@fi,
        "Utilisez quand le type d'instrument est connu, mais pas présent dans la liste."@fr,
        "Utilizzare quando il tipo di strumento è conosciuto, ma non è presente nell'elenco."@it,
        "Naudoti, kai instrumento tipas yra žinomas, bet jo sąraše nėra."@lt,
        ""@nl,
        "Bruk når instrumenttypen er kjent, men ikke finnes i listen."@no,
        "Usar se o tipo de instrumento for conhecido, mas não se encontrar na lista."@pt,
        "Uporabite, ko je vrsta uporabljenega instrumenta znana, a je ne najdete na seznamu."@sl,
        "Koristiti kada je vrsta instrumenta poznata, ali se ne nalazi na listi."@sr,
        "Använd när typ av instrument är känt men saknas i listan."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en,
        "Muu keruuväline"@fi,
        "Autre"@fr,
        "Altro"@it,
        "Kita "@lt,
        "Anders"@nl,
        "Annet"@no,
        "Outro"@pt,
        "Drugo"@sl,
        "Ostalo"@sr,
        "Övrigt"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/732a2a6> a skos:Concept ;
    skos:definition "Guidelines regarding what will be observed. Depending on the study design, an observation guide can be more or less structured, ranging from exact specifications and scales to loosely formulated ideas."@en,
        "Havainnointitutkimuksessa käytetty suunnitelma siitä, mitä havainnoidaan. Tutkimusasetelmasta riippuen havainnointisuunnitelma voi olla enemmän tai vähemmän strukturoitu, vaihdellen tarkoista määrittelyistä ja asteikoista väljästi muotoiltuihin ideoihin."@fi,
        "Consignes concernant ce qui devra être observé. En fonction de la conception de l'étude, un guide d'observation peut être plus ou moins structuré, allant de spécifications et d'échelle à des idées vagues formulées."@fr,
        "Linee guida riguardanti ciò che verrà osservato. A seconda della disegno della ricerca, una guida all'osservazione può essere più o meno strutturata, variando da indicazioni e scale precise a idee formulate in modo generale."@it,
        "Gairės apibrėžiančios, kas bus stebima. Priklausomai nuo tyrimo plano, stebėjimo vadovas gali būti daugiau ar mažiau struktūruotas. Gairės gali pateikti tikslias taisykles ir skales, arba tik laisvai suformuluotas idėjas."@lt,
        ""@nl,
        "Retningslinjer til det som skal observeres. En observasjonsguide kan være mer eller mindre strukturert avhengig av studiedesignet. Den kan variere fra eksakte spesifikasjoner og skalaer til løst formulerte ideer."@no,
        "Orientações ou instruções sobre o que será observado. Dependendo da concepção do estudo, uma grelha de observação pode ser mais ou menos estruturada, variando de especificações exatas e escalas a ideias formuladas de uma forma vaga."@pt,
        "Smernice za opazovanje. Glede na načrt raziskave je vodnik za opazovanje lahko bolj ali manj strukturiran, od natančnih določitev in lestvic do ohlapno oblikovanih idej."@sl,
        "Smernice o tome šta će se posmatrati. U zavisnosti od dizajna studije, uputstvo za posmatranje može biti manje ili više struktuirano, u rasponu od tačnih specifikacija i skala, do slabo formulisanih ideja."@sr,
        "Guide till det som ska observeras. Beroende på studiedesign kan en observationsguide vara mer eller mindre strukturerad, allt från exakta specifikationer och skalor till löst formulerade idéer."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "DataCollectionGuidelines.ObservationGuide"@en ;
    skos:prefLabel "Data collection guidelines: Observation guide"@en,
        "Aineistonkeruuohjeistus: havainnointiohje tai -suunnitelma"@fi,
        "Consignes de collecte de données : guide d'observation"@fr,
        "Linee guida per la raccolta dei dati: traccia di osservazione"@it,
        "Duomenų rinkimo gairės: stebėjimo vadovas"@lt,
        "Richtlijnen voor gegevensverzameling: Observatie handleiding"@nl,
        "Retningslinjer for datainnsamling: Observasjonsguide"@no,
        "Orientações para a recolha de dados: Grelha de observação"@pt,
        "Smernice za zbiranje podatkov: vodnik za opazovanje"@sl,
        "Smernice za prikupljanje podataka: Uputstvo za posmatranje"@sr,
        "Datainsamlingsguide: Observationsguide"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/8acc4c6> a skos:Concept ;
    skos:definition "Set of pre-determined questions, a great majority of which are open-ended, although there may be a small proportion of close-ended questions."@en,
        "Kysely- tai ilmoituslomake. Kysymykset ovat ennalta määriteltyjä. Ne ovat useimmiten avokysymyksiä, vaikkakin mukana saattaa olla pieni määrä kysymyksiä, joissa on valmiit vastausvaihtoehdot."@fi,
        "Ensemble de questions prédéterminées, une grande majorité d'entre elles sont ouvertes, bien qu'il y ait peut-être une petite proportion de questions fermées."@fr,
        "Insieme di domande pre-determinate, la maggior parte delle quali prevede risposte aperte, sebbene possa esserci una piccola percentuale di domande a risposta chiusa."@it,
        "Iš anksto parengtų klausimų rinkinys, kuriame dauguma klausimų yra atviri, bet gali būti ir nedidelė dalis uždarų klausimų."@lt,
        ""@nl,
        "Oppsett med forhåndsbestemte spørsmål hvor de fleste er åpne. Det kan forekomme en liten andel lukkede spørsmål."@no,
        "Conjunto de questões pré-determinadas, das quais a grande maioria são abertas, embora possa haver uma pequena proporção de questões fechadas."@pt,
        "Nabor vnaprej določenih vprašanj, izmed katerih je velika večina vprašanj odprtega tipa, čeprav je lahko majhen delež vprašanj tudi zaprtega tipa."@sl,
        "Skup unapred utvrđenih pitanja, od kojih je velika većina otvorena, mada može postojati mali deo bliskih pitanja."@sr,
        "En uppsättning förutbestämda frågor, av vilka en stor majoritet är öppna, även om det kan finnas en liten andel slutna frågor."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "Questionnaire.Unstructured"@en ;
    skos:prefLabel "Unstructured questionnaire"@en,
        "Strukturoimaton lomake"@fi,
        "Questionnaire non structuré"@fr,
        "Questionario non strutturato"@it,
        "Nestruktūruotas klausimynas"@lt,
        "Ongestructureerde vragenlijst"@nl,
        "Ustrukturert spørreskjema"@no,
        "Questionário aberto/não estruturado"@pt,
        "Nestrukturiran vprašalnik"@sl,
        "Nestrukturirana anketa"@sr,
        "Ostrukturerat frågeformulär"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/aa1571e> a skos:Concept ;
    skos:definition "Set of pre-determined questions, a great majority of which are closed-ended, although there may be a small proportion of open-ended questions."@en,
        "Kysely- tai ilmoituslomake. Kysymykset ovat ennalta määriteltyjä. Kysymyksiin on useimmiten laadittu valmiit vastausvaihtoehdot, joskin mukana saattaa olla pieni määrä avokysymyksiä."@fi,
        "Ensemble de questions prédéterminées, une grande majorité d'entre elles sont fermées, bien qu'il y ait peut-être une petite proportion de questions ouvertes."@fr,
        "Insieme di domande pre-determinate, la maggior parte delle quali prevede risposte chiuse, sebbene possa esserci una piccola percentuale di domande a risposta aperta."@it,
        "Iš anksto parengtų klausimų rinkinys, kuriame dauguma klausimų yra uždari, bet gali būti ir nedidelė dalis atvirų klausimų."@lt,
        ""@nl,
        "Oppsett med forhåndsbestemte spørsmål hvor de fleste er lukkede. Det kan forekomme en liten andel åpne spørsmål."@no,
        "Conjunto de questões pré-determinadas, das quais a grande maioria são fechadas, embora possa haver uma pequena proporção de questões abertas."@pt,
        "Nabor vnaprej določenih vprašanj, izmed katerih je velika večina vprašanj zaprtega tipa, čeprav je lahko majhen delež vprašanj tudi odprtega tipa."@sl,
        "Skup unapred utvrđenih pitanja, od kojih je velika većina zatvorenih, mada može postojati i mali procenat otvorenih pitanja."@sr,
        "En uppsättning förutbestämda frågor, av vilka en stor majoritet är slutna, även om det kan finnas en liten andel öppna frågor."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "Questionnaire.Structured"@en ;
    skos:prefLabel "Structured questionnaire"@en,
        "Strukturoitu lomake"@fi,
        "Questionnaire structuré"@fr,
        "Questionario strutturato"@it,
        "Struktūruotas klausimynas"@lt,
        "Gestructureerde vragenlijst"@nl,
        "Strukturert spørreskjema"@no,
        "Questionário estruturado"@pt,
        "Strukturiran vprašalnik"@sl,
        "Strukturirana anketa"@sr,
        "Strukturerat frågeformulär"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/bf31e36> a skos:Concept ;
    skos:definition "Guidelines regarding the desired, or expected content of self-written personal accounts or narratives from potential participants. The instructions can be supplied as part of the writing invitation or separately. For example, an invitation asking people suffering from a specific disease or disability to describe how it affects their feelings, social relations, and everyday life; or a writing invitation asking people to keep a diary of books read during a period of six months and the thoughts provoked by the books."@en,
        "Kirjoitusaineistojen keräämistä varten annetut kirjoitusohjeet joko kirjoituskutsun osana tai erillisenä. Esimerkkejä: Kirjoituskutsussa pyydetään tietyn sairauden tai vamman omaavia ihmisiä  kuvailemaan kuinka se vaikuttaa heidän tunteisiinsa, ihmissuhteisiinsa ja jokapäiväiseen elämäänsä; ohjeistus lukupäiväkirjalle, johon osanottaja kirjaa lukemansa kirjat ja niiden herättämät ajatukset."@fi,
        "Consignes concernant le contenu attendu ou désiré des écrits personnels ou narratifs de participants potentiels. Les instructions peuvent être fournies dans le cadre de l'invitation écrite ou séparément. Par exemple, une invitation demandant aux personnes souffrant d'une maladie ou un handicap spécifique de décrire comment cela affecte leurs sentiments, leurs relations sociales et la vie quotidienne ; ou une invitation écrite demandant aux personnes de tenir un journal des livres lus pendant une période de six mois et les pensées provoquées par les livres."@fr,
        "Linee guida relative al contenuto desiderato o atteso di documenti o narrazioni personali dei potenziali partecipanti allo studio. Le istruzioni possono essere fornite come parte dell'invito a partecipare oppure separatamente. Ad esempio, un invito che chiede alle persone che soffrono di una specifica malattia o disabilità di descrivere come essa influisca sui loro sentimenti, sulle relazioni sociali e sulla vita quotidiana; oppure un invito a tenere un diario dei libri letti durante un periodo di sei mesi con la richiesta di riportare i pensieri suscitati dai libri."@it,
        "Potencialių dalyvių savarankiškai rašomų asmeninių pasakojimų ar naratyvų turinio kūrimo gairės. Instrukcijos gali būti pateiktos kartu su kvietimu rašyti arba atskirai. Pavyzdžiui, kvietimas, kuriame žmonių, kenčiančių nuo konkrečios ligos ar negalios, prašoma aprašyti, kaip tai veikia jų jausmus, socialinius ryšius ir kasdienį gyvenimą; arba kvietimas, kuriame žmonių prašoma šešis mėnesius rašyti perskaitytų knygų dienoraštį ir kilusias mintis."@lt,
        ""@nl,
        "Retningslinjer angående ønsket eller forventet innhold i selvskrevne personlige fortellinger fra potensielle deltakere. Instruksjonene kan bli utdelt som del av invitasjonen til å skrive, eller den kan gis ut separat. For eksempel en invitasjon som ber folk med livstruende sykdommer beskrive hvordan sykdommen påvirker deres følelser, sosiale relasjoner og hverdagsliv; eller en skriveinvitasjon som ber folk føre en dagbok over hvilke bøker de leser over en seksmånedersperiode og hvilke tanker bøkene vekker."@no,
        "Orientações ou instruções sobre o conteúdo esperado ou desejado de relatos ou narrativas pessoais de potenciais participantes. As instruções podem ser fornecidas como parte do guião ou separadamente. Por exemplo, um convite pedindo/solicitando às pessoas que sofrem de uma doença específica ou incapacidade/limitação para descrever como isso afeta os sentimentos, as relações sociais e a vida quotidiana; ou um convite por escrito pedindo às pessoas para manterem um diário dos livros lidos durante um período de seis meses e dos pensamentos por eles suscitados."@pt,
        "Smernice o želeni ali pričakovani vsebini samoizpolnjenih osebnih dnevnikov ali pripovedi potencialnih udeležencev. Navodila so lahko na voljo kot del napisanega vabila ali ločeno. Na primer, obvestilo o literarnem natečaju, ki vabi ljudi z življenjsko nevarno boleznijo, da opišejo, kako bolezen vpliva na njihove občutke, medsebojne odnose in vsakdanje življenje; ali pisno vabilo posameznikom, naj vodijo dnevnik prebranih knjig v šestih mesecih in si zapisujejo misli, ki se jim porajajo ob branju."@sl,
        "Smernice o željenom ili očekivanom sadržaju samostalno sastavljenih ličnih zapisa ili svedočanstvima potencijalnih učesnika. Uputstva se mogu biti deo pismenog poziva ili odvojena. Na primer, poziv koji traži od ljudi koji pate od određene bolesti ili invaliditeta da opišu kako to utiče na njihova osećanja, društvene odnose i svakodnevni život; ili poziv za pisanje kojim se traži da ljudi vode dnevnik čitanja knjiga tokom perioda od šest meseci i misli koje izazivaju knjige."@sr,
        "Guide för önskat eller förväntat innehåll i självskrivna personliga redogörelser eller berättelser från potentiella deltagare. Anvisningarna kan levereras separat eller som en del av inbjudan att delta i skrivandet. Till exempel en inbjudan till människor med en viss sjukdom eller funktionsnedsättning om att beskriva hur det påverkar deras känslor, sociala relationer och vardagsliv. Eller en skrivinbjudan som ber människor att föra dagbok om vilka böcker de läser under en period av sex månader och de tankar som väcks av böckerna."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "DataCollectionGuidelines.SelfAdministeredWritingsGuide"@en ;
    skos:prefLabel "Data collection guidelines: Self-administered writings guide"@en,
        "Aineistonkeruuohjeistus: kirjoitusohje"@fi,
        "Consignes de collecte de données : guide des écrits auto-administrés"@fr,
        "Linee guida per la raccolta dei dati: scritti autocompilati"@it,
        "Duomenų rinkimo gairės: savarankiškai rašomų tekstų vadovas"@lt,
        "Richtlijnen voor gegevensverzameling: Instructie voor zelf invullen"@nl,
        "Retningslinjer for datainnsamling: Selvadministrert skriveguide"@no,
        "Orientações para a recolha de dados: Guião para registos  de autopreenchimento"@pt,
        "Smernice za zbiranje podatkov: vodnik za samoizpolnjevanje"@sl,
        "Smernice za prikupljanje podataka: Vodič za samostalno upravljanje zapisima"@sr,
        "Datainsamlingsguide: Guide för självadministrerade skriftliga uppgifter"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/c23aada> a skos:Concept ;
    skos:definition "Programming script written in a data query language that is used to extract specific data, for instance from online social networks."@en,
        "Halutun kaltaista dataa on poimittu ohjelmallisesti, esimerkiksi sosiaalisesta mediasta tai muista verkkolähteistä."@fi,
        "Script de programmation écrit dans un langage de requête de données qui est utilisé pour extraire des données spécifiques, par exemple des réseaux sociaux en ligne."@fr,
        "Script di programmazione sviluppato in un linguaggio di interrogazione dei dati che viene utilizzato per estrarre dati specifici, ad esempio dai social network online."@it,
        "Programavimo skriptas, parašytas duomenų užklausos kalba, ir naudojamas konkrečių duomenų gavybai, pavyzdžiui, iš internetinių socialinių tinklų."@lt,
        ""@nl,
        "Programmeringsskript som er skrevet i et skriptprogrammeringsspråk som blir brukt til å trekke ut bestemte opplysninger, for eksempel fra sosiale nettverk på internett."@no,
        "Script de programação escrito numa linguagem de pesquisa de dados, que é usado para extrair dados específicos, nomeadamente de redes sociais online."@pt,
        "Koda za programiranje, napisana v jeziku poizvedbe, ki se uporablja za pridobivanje določenih podatkov, na primer iz spletnih socialnih omrežij."@sl,
        "Programska skripta napisana na Data Query jeziku (DQL) koja se koriste za izvlačenje određenih podataka, na primer, iz društvenih mreža."@sr,
        "Ett skript som är skrivet i ett förfrågningsspråk (data query language) och som används för att extrahera specifika data, t.ex. från sociala nätverk på nätet."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "ProgrammingScript"@en ;
    skos:prefLabel "Programming script"@en,
        "Ohjelmointikoodi"@fi,
        "Script de programmation"@fr,
        "Script di programmazione"@it,
        "Programavimo skriptas"@lt,
        "Programmeerscript"@nl,
        "Programmeringsskript"@no,
        "Script/Esquema de programação"@pt,
        "Programska koda"@sl,
        "Programska skripta"@sr,
        "Skript"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/c2d7227> a skos:Concept ;
    skos:definition "Themes, topics, and/or questions used in an interview. Can vary between loosely defined themes to more exactly formulated questions. There is more flexibility than in an unstructured questionnaire regarding which questions are asked of each participant and how they are conveyed."@en,
        "Haastattelututkimuksessa käytetyt haastatteluteemat tai -kysymykset. Vaihtelevat väljästi muotoilluista teemoista melko tarkasti muotoiltuihin kysymyksiin. Jälkimmäisessä tapauksessa ero strukturoimattomaan lomakkeeseen on siinä, että kaikille osanottajille ei esitetä kaikkia kysymyksiä tai kysymysten muotoilu on vapaampaa."@fi,
        "Thèmes, sujets, et / ou questions utilisés dans un entretien. Peut varier entre des thèmes vaguement définis et des questions formulées plus précisément. Il y a plus de souplesse que dans un questionnaire non structuré en ce qui concerne les questions qui sont posées à chaque participant et la manière dont elles sont transmises."@fr,
        "Temi, argomenti e/o domande utilizzate in un'intervista. Può variare tra temi definiti in modo ampio e domande formulate in modo più preciso. Rispetto a un questionario non strutturato c'è una maggiore flessibilità riguardo a quali domande vengono effettivamente poste a ciascun partecipante e come esse vengono poste."@it,
        "Temos ir (arba) klausimai, naudojami interviu metu. Gali apimti ir laisvai apibrėžtas temas ir tiksliau suformuluotus klausimus. Lyginant su nestruktūruotu klausimynu, čia daugiau lankstumo pateikiant klausimus ar juos užduodant skirtingiems dalyviams."@lt,
        ""@nl,
        "Tema, emner og/eller spørsmål brukt i et intervju. Kan variere mellom løst definerte tema til mer nøyaktig formulerte spørsmål. Mer fleksibilitet enn i ustrukturerte spørreskjema når det kommer til hvilke spørsmål som blir stilt hver deltaker og hvordan de blir stilt."@no,
        "Temas, tópicos e/ou questões usados numa entrevista. Pode variar entre temas vagamente definidos para questões mais especificamente formuladas. Há mais flexibilidade do que num questionário não estruturado relativamente a que questões são colocadas a cada participante e como elas são abordadas."@pt,
        "Teme in/ali vprašanja, uporabljena v intervjuju. Lahko se razteza od široko opredeljenih tem do natančneje oblikovanih vprašanj. V primerjavi z nestrukturiranim vprašalnikom je več prožnosti glede vprašanj, ki jih postavimo udeležencem, in načina, kako jih posredujemo."@sl,
        "Teme i/ili pitanja koja se koriste u intervjuu. Mogu varirati između okvirno definisanih tema do precizno formulisanih pitanja. Postoji veća fleksibilnost nego u nestrukturiranom upitniku u vezi sa tim koja se pitanja postavljaju svakom učesniku i kako se prenose."@sr,
        "Teman, ämnen och/eller frågor som används i en intervju. Kan variera mellan löst definierade teman och mer exakt formulerade frågor. Det finns mer flexibilitet än i ett ostrukturerat frågeformulär angående vilka frågor som ställs till varje deltagare och hur de förmedlas."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "InterviewSchemeAndThemes"@en ;
    skos:prefLabel "Interview scheme and/or themes"@en,
        "Haastatteluteemat tai haastattelurunko"@fi,
        "Schéma et / ou thèmes d'entretien"@fr,
        "Traccia e/o temi di intervista"@it,
        "Interviu planas ir (arba) temos"@lt,
        "Interviewschema en/of thema's"@nl,
        "Intervjuskjema og/eller tema"@no,
        "Esquema/temas de entrevista"@pt,
        "Načrt intervjuja in/ali teme"@sl,
        "Okvir intervjua i/ili teme"@sr,
        "Intervjuschema och/eller teman"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/db1f13d> a skos:Concept ;
    skos:definition "Set of pre-determined questions, a significant proportion of which are open-ended (roughly one third to two thirds), and the rest are closed-ended."@en,
        "Kysely- tai ilmoituslomake. Kysymykset ovat ennalta määriteltyjä. Avokysymysten osuus on merkittävä ja vaihtelee suunnilleen kolmasosasta kahteen kolmasosaan. Lopuissa kysymyksissä on valmiit vastausvaihtoehdot."@fi,
        "Ensemble de questions prédéterminées, une proportion significative d'entre elles sont ouvertes (environ un tiers à deux tiers), et les restantes sont fermées."@fr,
        "Insieme di domande pre-determinate, di cui una parte significativa presenta risposta aperte (indicativamente tra un terzo e due terzi del totale), e le restanti sono chiuse."@it,
        "Iš anksto parengtų klausimų rinkinys, kuriame didelė dalis (maždaug nuo vieno iki dviejų trečdalių) klausimų yra atviri, o kiti – uždari."@lt,
        ""@nl,
        "Oppsett med forhåndsbestemte spørsmål hvor en betydelig andel er åpne (ca. én til to tredjedeler), og resten er lukket."@no,
        "Conjunto de questões pré-determinadas, das quais uma parte significativa são abertas (cerca de um terço a dois terços), sendo as restantes fechadas."@pt,
        "Nabor vnaprej določenih vprašanj, izmed katerih je pomemben delež vprašanj odprtega tipa (približno ena do dve tretjini), preostali del pa zaprtega tipa."@sl,
        "Skup unapred utvrđenih pitanja, čiji je značajan deo otvoren (otprilike jedna trećina do dve trećine), a ostala su zatvorena."@sr,
        "En uppsättning förutbestämda frågor, av vilka en signifikant majoritet är öppna (cirka en till två tredjedelar), och resten är slutna."@sv ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfInstrument/1.1.2/> ;
    skos:notation "Questionnaire.Semistructured"@en ;
    skos:prefLabel "Semi-structured questionnaire"@en,
        "Puolistrukturoitu lomake"@fi,
        "Questionnaire semi-structuré"@fr,
        "Questionario semi-strutturato"@it,
        "Pusiau struktūruotas klausimynas"@lt,
        "Semi-gestructureerde vragenlijst"@nl,
        "Semistrukturert spørreskjema"@no,
        "Questionário semiestruturado"@pt,
        "Polstrukturiran vprašalnik"@sl,
        "Polustrukturirana anketa"@sr,
        "Semistrukturerat frågeformulär"@sv .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/0be8406> a skos:Concept ;
    skos:definition "A human-readable comment, typically of a more subjective nature than an addendum."@en,
        "Žmogui suprantamas komentaras, paprastai subjektyvesnio pobūdžio nei papildymas."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Comment"@en ;
    skos:prefLabel "Comment"@en,
        "Komentaras"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/6311ae1> a skos:Concept ;
    skos:definition "Use when the type of note is known, but not found in the list."@en,
        "Naudoti, kai pastabos tipas yra žinomas, bet sąraše jo nėra."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en,
        "Kita"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/643562a> a skos:Concept ;
    skos:definition "A note related to the processing of the data, or metadata, or both."@en,
        "Pastaba, susijusi su duomenų ir (arba) metaduomenų tvarkymu."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Processing"@en ;
    skos:prefLabel "Processing note"@en,
        "Apdorojimo pastaba"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/a45da96> a skos:Concept ;
    skos:definition "A note generated by the processing system used to produce the data, or metadata, or both."@en,
        "Sistemos, skirtos duomenų ir (arba) metaduomenų kūrimui, sukurta pastaba."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "System"@en ;
    skos:prefLabel "System note"@en,
        "Sistemos pastaba"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/c680d43> a skos:Concept ;
    skos:definition "A note providing information on an aspect relevant for data usage that is likely to remain permanent, or a temporary note providing information for further review and correction. May be an observation entered by a human user or a system-generated note on any inconsistencies or deviations."@en,
        "Pastaba, kurioje pateikiama informacija apie duomenų naudojimui svarbų aspektą, greičiausiai būsianti aktuali visada, arba laikina pastaba, kurioje pateikiama informacija yra aktuali tolesnei peržiūrai ir taisymui. Tai gali būti žmogaus įvestas pastebėjimas arba sistemos sukurtas pastebėjimas apie bet kokius neatitikimus ar nukrypimus."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Observation"@en ;
    skos:prefLabel "Observation"@en,
        "Pastebėjimas"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/efcfc2f> a skos:Concept ;
    skos:definition "Additional information, usually of a factual nature (as opposed to a comment), intended to clarify the content of a DDI section or module."@en,
        "Papildoma informacija, paprastai faktinio pobūdžio (priešingai nei komentaras), skirta paaiškinti DDI skyriaus ar modulio turinį."@lt ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfNote/1.1.1/> ;
    skos:notation "Addendum"@en ;
    skos:prefLabel "Addendum"@en,
        "Papildymas"@lt .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/30ba591> a skos:Concept ;
    skos:definition "A fixed telephone of an organization, institution or business, or the work telephone of a person employed by the organization."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Fixed.OrganizationBusiness"@en ;
    skos:prefLabel "Fixed telephone: Organization/Business"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/3ca0762> a skos:Concept ;
    skos:definition "A fixed telephone belonging to a private person, usually located in a home or a private dwelling unit."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Fixed.PersonalPrivate"@en ;
    skos:prefLabel "Fixed telephone: Personal/Private"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/40a4f9e> a skos:Concept ;
    skos:definition "The fax of an organization, institution or business, or the work fax of a person employed by the organization."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Fax.OrganizationBusiness"@en ;
    skos:prefLabel "Fax: Organization/Business"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/4457d44> a skos:Concept ;
    skos:definition "A telephone that transmits signals converted from audio data through physical media, such as wire or fiber optic cable; also known as landline."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/30ba591>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/3ca0762> ;
    skos:notation "Fixed"@en ;
    skos:prefLabel "Fixed telephone"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/6311ae1> a skos:Concept ;
    skos:definition "Use when the type of telephone is known, but not found in the list."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/87d17f4> a skos:Concept ;
    skos:definition "A portable telephone connected to a wireless communications network through radio waves or satellite transmissions; includes phones known as cellular (or cell) phones, hand phones, as well as satellite phones."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/d2278ff>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/f932b45> ;
    skos:notation "Mobile"@en ;
    skos:prefLabel "Mobile telephone"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/9810aa2> a skos:Concept ;
    skos:definition "A fax (short for facsimile) is a device used for the telephonic transmission of scanned-in printed material (text or images), usually to a telephone number associated with a printer or other output device; also known as telecopying."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/40a4f9e>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/b46b400> ;
    skos:notation "Fax"@en ;
    skos:prefLabel "Fax"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/b46b400> a skos:Concept ;
    skos:definition "A fax belonging to a private person."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Fax.PersonalPrivate"@en ;
    skos:prefLabel "Fax: Personal/Private"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/d2278ff> a skos:Concept ;
    skos:definition "A mobile telephone of an organization, institution or business, or the mobile work telephone of a person employed by the organization."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Mobile.OrganizationBusiness"@en ;
    skos:prefLabel "Mobile telephone: Organization/Business"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/f932b45> a skos:Concept ;
    skos:definition "A mobile telephone belonging to a private person."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTelephone/1.0.0/> ;
    skos:notation "Mobile.PersonalPrivate"@en ;
    skos:prefLabel "Mobile telephone: Personal/Private"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/100bf39> a skos:Concept ;
    skos:definition "A single translator produces one translation. Use this broader term if the translator makes the decisions about the final version, if it is not known who makes the final decisions, or if the review process is not explained in either of the narrower terms."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/bdd4b48>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/d0fd2ac> ;
    skos:notation "SingleTranslation"@en ;
    skos:prefLabel "Single translation"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/199a35c> a skos:Concept ;
    skos:definition "Two or more translators produce one translation by splitting up a source text (for example, a questionnaire) into subsections and each translating a subsection. A committee, possibly including the translators, reviews the whole translation and approves the final version. There may be more than one review round. In survey translation, the committee may include survey, domain and language experts."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "SplitTranslation.CommitteeReview"@en ;
    skos:prefLabel "Split translation: Committee review"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/3305b85> a skos:Concept ;
    skos:definition "Two or more translators each produce a separate, independent  translation of a whole text. A committee, possibly including the translators, reviews all the translations, and makes decisions on the final version. There may be more than one review round. In survey translation, the committee may include survey, domain and language experts."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "ParallelTranslations.CommitteeReview"@en ;
    skos:prefLabel "Parallel translations: Committee review"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/61c9399> a skos:Concept ;
    skos:definition "Two or more translators produce one translation by splitting up a source text (for example, a questionnaire) into subsections and each translating a subsection. An individual reviews the whole translation, possibly in consultation with the translators. There may be more than one review round and different individual reviewers in each round. An adjudicator (possibly a reviewer) approves the final version."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "SplitTranslation.IndividualReview"@en ;
    skos:prefLabel "Split translation: Individual review"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/6311ae1> a skos:Concept ;
    skos:definition "The translation method is known but not in the list. If needed, use the free-text element for a more extensive description."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "Other"@en ;
    skos:prefLabel "Other"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/6cc8949> a skos:Concept ;
    skos:definition "Two or more countries or regions sharing the same language cooperate in the translation process, producing a commonly agreed translation which each country or region can then modify to account for linguistic, cultural, socio-economic or political differences. If needed, this term may be used alongside other relevant terms from this list."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "SameLanguageHarmonization"@en ;
    skos:prefLabel "Same language harmonization"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/873e3e3> a skos:Concept ;
    skos:definition "It is not known what kind of translation method has been used."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "TranslationMethodUnspecified"@en ;
    skos:prefLabel "Translation method unspecified"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/a403736> a skos:Concept ;
    skos:definition "Two or more translators each produce a separate,  independent  translation of a whole text. Use this broader term if the  translators decide on a final version amongst themselves, if it is not known who makes the final decisions or if the review process is not described in either of the narrower terms."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/3305b85>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/d2cd6a9> ;
    skos:notation "ParallelTranslations"@en ;
    skos:prefLabel "Parallel translations"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/a6285c5> a skos:Concept ;
    skos:definition "Two or more translators produce one translation by splitting up a source text (for example, a questionnaire) into subsections and each translating a subsection. Use this broader term if the translators decide on the final version amongst themselves, if it is not known who makes the final decisions or if the review process is not explained in either of the narrower terms."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:narrower <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/199a35c>,
        <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/61c9399> ;
    skos:notation "SplitTranslation"@en ;
    skos:prefLabel "Split translation"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/bdd4b48> a skos:Concept ;
    skos:definition "A single translator produces one translation. A committee, possibly including the translator, reviews it and approves the final version. There may be more than one review round. In survey translation, the committee may include survey, domain and language experts."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "SingleTranslation.CommitteeReview"@en ;
    skos:prefLabel "Single translation: Committee review"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/d0fd2ac> a skos:Concept ;
    skos:definition "A single translator produces one translation. Another individual reviews the translation, possibly in consultation with the translator. There may be more than one review round and different individual reviewers in each round.  An  adjudicator (possibly a reviewer) approves the final version."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "SingleTranslation.IndividualReview"@en ;
    skos:prefLabel "Single translation: Individual review"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/d2cd6a9> a skos:Concept ;
    skos:definition "Two or more translators each produce a separate,  independent  translation of a whole text. An individual reviews all the translations and makes decisions on the final version, possibly in consultation with the translators. There may be more than one review round and different individual reviewers in each round. An adjudicator (possibly a reviewer) approves the final version."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "ParallelTranslations.IndividualReview"@en ;
    skos:prefLabel "Parallel translations: Individual review"@en .

<http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/fc988a3> a skos:Concept ;
    skos:definition "A country or region uses the final translation of another country or region sharing the same language as the basis for their own translation. Some of the content of the original translation is modified to reflect linguistic, cultural, socio-economic or political differences. If needed, this term may be used alongside other relevant terms from this list."@en ;
    skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/TypeOfTranslationMethod/1.0.0/> ;
    skos:notation "SameLanguageAdaptation"@en ;
    skos:prefLabel "Same language adaptation"@en .

